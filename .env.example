# Load a profile before the script, for example: node --env-file=.env.local gateway/server.js
# Infrastructure credentials only. Tenant API credentials belong in strict SurrealDB records.

SURREAL_ENDPOINT=ws://127.0.0.1:8000/rpc
SURREAL_USERNAME=root
SURREAL_PASSWORD=replace-me
SURREAL_NAMESPACE=test
SURREAL_DATABASE=test
SURREAL_CONNECT_TIMEOUT_MS=10000

REBASE_RUNTIME_URL=http://127.0.0.1:8788
REBASE_RUNTIME_SECRET=replace-with-a-long-random-secret
REBASE_ALLOWED_CONTEXTS=[{"namespace":"test","database":"test"}]

REBASE_HTTP_HOST=127.0.0.1
REBASE_HTTP_PORT=8788
REBASE_HTTP_BODY_LIMIT_BYTES=262144
REBASE_HTTP_REQUEST_TIMEOUT_MS=30000
REBASE_HTTP_DEBUG=true
# Scan every minute; the worker can enqueue tasks five minutes before due time.
REBASE_RECONCILE_INTERVAL_MS=60000
REBASE_TERMINAL_TASK_RETENTION_DAYS=30

REBASE_QUEUE_PREFIX=rebase
REBASE_QUEUE_REDIS_URL=redis://127.0.0.1:6379
REBASE_QUEUE_REDIS_CONNECT_TIMEOUT_MS=5000
REBASE_QUEUE_STARTUP_TIMEOUT_MS=10000
REBASE_QUEUE_HEALTH_TIMEOUT_MS=2000

# One shared bucket is used across all namespace/database contexts. Object keys
# contain a context hash, so tenant bucket names are neither needed nor honored.
REBASE_STORAGE_BUCKET=replace-with-shared-storage-bucket

# Stable key for encrypting queued authentication-delivery payloads. In
# production, supply at least 32 bytes and keep it separate from the runtime
# event-authentication secret. Provider credentials and senders live in typed
# protected database rows.
REBASE_AUTHENTICATION_PAYLOAD_SECRET=replace-with-at-least-32-random-bytes
REBASE_AUTHENTICATION_CHALLENGE_TTL_MS=600000
REBASE_AUTHENTICATION_RATE_LIMIT_WINDOW_MS=900000
REBASE_AUTHENTICATION_RATE_LIMIT_IP=10
REBASE_AUTHENTICATION_RATE_LIMIT_IDENTIFIER=3

# Documentation-only record fixtures for an LLM or developer test harness.
# The shared environment loader never resolves or logs REBASE_TEST_RECORD__*.
# REBASE_TEST_RECORD__EMAIL_BREVO_CONFIG__LOGIN=replace-with-test-record-value
# REBASE_TEST_RECORD__EMAIL_BREVO_CONFIG__SMTP=replace-with-test-record-value
# REBASE_TEST_RECORD__EMAIL_BREVO_CONFIG__API_KEY=replace-with-test-record-value
# REBASE_TEST_RECORD__FILE_STORAGE_CONFIG__ENDPOINT=replace-with-test-record-value
# REBASE_TEST_RECORD__FILE_STORAGE_CONFIG__REGION=replace-with-test-record-value
# REBASE_TEST_RECORD__FILE_STORAGE_CONFIG__ACCESS_KEY_ID=replace-with-test-record-value
# REBASE_TEST_RECORD__FILE_STORAGE_CONFIG__SECRET_ACCESS_KEY=replace-with-test-record-value
# REBASE_TEST_RECORD__RAZORPAY_CONFIG__KEY_ID=replace-with-test-record-value
# REBASE_TEST_RECORD__RAZORPAY_CONFIG__KEY_SECRET=replace-with-test-record-value
# REBASE_TEST_RECORD__RAZORPAY_CONFIG__WEBHOOK_SECRET=replace-with-test-record-value
