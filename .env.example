# SURREAL_ENDPOINT=http://127.0.0.1:8000
SURREAL_ENDPOINT=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=replace-me
SURREAL_CONNECT_TIMEOUT_MS=10000
REBASE_NAMESPACE=test
REBASE_DATABASE=test
# REBASE_CONTEXTS=[{"namespace":"tenant","database":"app"}]
REBASE_WAKE_SECRET=replace-with-a-long-random-secret
REBASE_PORT=8788
REBASE_PROVIDER=local
REBASE_QUEUE_PROVIDER=bullmq
REBASE_REDIS_URL=redis://127.0.0.1:6379
REBASE_QUEUE_PREFIX=rebase
# Internal runtime/webhook authentication; provider credentials live in config rows.
REBASE_EMAIL_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
REBASE_STORAGE_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
REBASE_DEBUG=true
