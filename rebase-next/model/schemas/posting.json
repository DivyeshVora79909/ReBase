{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "units": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,2}|-?1000)$",
      "x-rebase-binding": "i128",
      "x-rebase-range": [
        "-1000",
        "1000"
      ]
    },
    "at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})$",
      "x-rebase-binding": "i64",
      "x-rebase-range": [
        "-9223372036854775808",
        "9223372036854775807"
      ]
    },
    "rule": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "x-rebase-binding": "uuid"
    },
    "curve": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "x-rebase-binding": "uuid"
    },
    "account": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "x-rebase-binding": "uuid"
    },
    "subsidiary": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "x-rebase-binding": "uuid"
    }
  },
  "required": [
    "units",
    "at",
    "rule",
    "curve",
    "account",
    "subsidiary"
  ],
  "additionalProperties": false
}
