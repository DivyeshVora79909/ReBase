{
  "contract_code": 17,
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "tenant", "owner", "account", "effective_ns", "quantity", "unit_price"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "tenant": { "type": "string", "format": "uuid" },
      "owner": { "type": "string", "format": "uuid" },
      "account": { "type": "string", "format": "uuid" },
      "effective_ns": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
      "quantity": { "type": "integer", "minimum": 0, "maximum": 100000 },
      "unit_price": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$" }
    }
  },
  "fields": [
    { "name": "a_amount", "inputs": ["quantity", "z_price_units"] },
    { "name": "z_price_units", "inputs": ["unit_price"] },
    { "name": "quantity", "inputs": [] },
    { "name": "unit_price", "inputs": [] }
  ],
  "memberships": [
    { "slot": 1, "root_slot": 1 },
    { "slot": 2, "root_slot": 2 }
  ]
}
