use rebase_semantic_proof as p;
use p::{binding::Calculation,model::Prepared,native_slice::{Context,Input,Record,Population},native_codec::{self,Key,StoredValue},local::{Store,PublicRecordValue},storage::{self,Database,TableDefinition},query::{PageRequest,RecordQuery}};
use uuid::Uuid;use sha2::{Sha256,Digest};use serde_json::json;use std::{sync::Arc,time::Instant};
const KV:TableDefinition<&[u8],&[u8]>=TableDefinition::new("native_kv");const PUBLIC:TableDefinition<&[u8],u16>=TableDefinition::new("public_records");
fn uid(rank:usize)->Uuid{let mut h=Sha256::new();h.update(b"actual-store-page-source-v1");h.update((rank as u64).to_be_bytes());let b=h.finalize();let mut id=[0;16];id.copy_from_slice(&b[..16]);id[6]=(id[6]&15)|64;id[8]=(id[8]&63)|128;Uuid::from_bytes(id)}
fn db(backend:&str,path:&str,cluster:Option<&str>)->Database{match backend{"redb"=>Database::open(path).unwrap(),"surrealkv"=>storage::surrealkv::connect(path).unwrap(),"foundationdb"=>storage::foundationdb::connect(cluster,b"actual-page-4096").unwrap(),_=>panic!()}}
fn fetch(store:&Store<Calculation>,model:&str,q:usize)->p::native_slice::Result<(Vec<PublicRecordValue<Calculation>>,usize,bool,Option<String>)>{let mut records=Vec::new();let mut cursor=None;let mut calls=0;let mut exhausted=false;while records.len()<q{let request=PageRequest{model:model.into(),query:RecordQuery{path:"records.by_id".into(),contract:Some(8),equals:None},limit:(q-records.len()).min(32)as u16,visit_budget:128,cursor};let result=store.page(&request)?;calls+=1;records.extend(result.records);cursor=result.cursor;exhausted=result.exhausted;if exhausted{break;}}Ok((records,calls,exhausted,cursor))}
fn main(){let args:Vec<_>=std::env::args().collect();let backend=&args[1];let cluster=args.get(2).map(|v|v.as_str());let _network=(backend=="foundationdb").then(||unsafe{foundationdb::boot()});let model=Arc::new(Prepared::<Calculation>::load().unwrap());let context=Context{tenant:uid(1),actor:uid(2)};let path=format!("/tmp/rebase-linked-read-study/page-{backend}");let initial=if backend=="redb"{Database::create(&path).unwrap()}else{db(backend,&path,cluster)};let store=Store::<Calculation>::create_backend(initial,model.clone(),context).unwrap();drop(store);let database=db(backend,&path,cluster);let mut expected=Vec::new();for lo in(0..4096).step_by(256){let tx=database.begin_write().unwrap();{let mut kv=tx.open_table(KV).unwrap();let mut public=tx.open_table(PUBLIC).unwrap();for i in lo..lo+256{let id=uid(i+100);let input=Input::Entry{account:uid(0),at:1000+i as i64*17,amount:1};let record=Record{contract:8,tenant:context.tenant,owner:context.actor,reader:context.actor,version:uid(3),input:input.clone(),derived:None};let key=Key::Record(id);kv.insert(key.encode().as_slice(),native_codec::encode_for::<Calculation>(&key,&StoredValue::Record(record)).unwrap().as_slice()).unwrap();public.insert(id.as_bytes().as_slice(),8).unwrap();expected.push(PublicRecordValue::<Calculation>{id,contract:8,version:uid(3),input,derived:None});}}tx.commit().unwrap();}let tx=database.begin_write().unwrap();{let mut kv=tx.open_table(KV).unwrap();let population=Population{counts:model.contracts().map(|c|(c.code,if c.code==8{4096}else{0})).collect(),reserved:0};kv.insert(Key::Population.encode().as_slice(),native_codec::encode_for::<Calculation>(&Key::Population,&StoredValue::Population(population)).unwrap().as_slice()).unwrap();}tx.commit().unwrap();drop(database);let store=Store::<Calculation>::open_backend(db(backend,&path,cluster),model.clone()).unwrap();expected.sort_by_key(|r|r.id);let mut h=Sha256::new();for r in &expected{h.update(serde_json::to_vec(r).unwrap());}println!("{}",json!({"fixture":"actual-public-page","n":4096,"backend":backend,"source_sha256":format!("{:x}",h.finalize()),"unsecured":true,"bulk_fixture_bypasses_mutation_and_reference_validation":true,"canonical_population_and_Store_open_passed":true,"ordering":"UUID","max_per_call":32,"visit_budget":128}));for q in[50usize,100,1000,4096]{let warm=fetch(&store,model.identity(),q).unwrap();assert_eq!(warm.0,expected[..q]);let mut times=Vec::new();let mut calls=0;let mut exhausted=false;let mut hash=String::new();for _ in 0..3{let t=Instant::now();let result=fetch(&store,model.identity(),q);let elapsed=t.elapsed().as_nanos()as u64;let result=result.unwrap();assert_eq!(result.0,expected[..q]);assert_eq!(result.1,q.div_ceil(32));let mut h=Sha256::new();for r in&result.0{h.update(serde_json::to_vec(r).unwrap());}hash=format!("{:x}",h.finalize());calls=result.1;exhausted=result.2;times.push(elapsed);}let mut sorted=times.clone();sorted.sort_unstable();println!("{}",json!({"backend":backend,"n":4096,"q":q,"op":"actual_Store_page_repeated","status":"passed","page_calls":calls,"median_ns":sorted[1],"samples_ns":times,"result_sha256":hash,"exhausted":exhausted,"binding_calls":null,"binding_counters_uninstrumented":true,"oracle_and_checksum_outside_timed_span":true}));}drop(store);if backend=="redb"{std::fs::remove_file(path).unwrap();}else if backend=="surrealkv"{std::fs::remove_dir_all(path).unwrap();}}
