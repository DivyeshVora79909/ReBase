import fs from 'node:fs';import {spawnSync} from 'node:child_process';import crypto from 'node:crypto';
const repo='/workspace/ReBase/rebase-next';const base=`${repo}/target/verification-build/release`;const root='/tmp/rebase-linked-read-study';const metaFile=`${base}/.fingerprint/rebase-semantic-proof-26d676da79419c4b/lib-rebase_semantic_proof.json`;const text=fs.readFileSync(metaFile,'utf8');const meta=JSON.parse(text);const selected={};
for(const[,name]of meta.deps){const match=text.match(new RegExp(`\\[\\d+,"${name}",false,(\\d+)\\]`));const exact=BigInt(match[1]);let found;
for(const dir of fs.readdirSync(`${base}/.fingerprint`)){if(!dir.startsWith(`${name}-`) && !dir.startsWith(`${name.replaceAll("_","-")}-`))continue;const marker=`${base}/.fingerprint/${dir}/lib-${name}`;if(!fs.existsSync(marker))continue;const v=fs.readFileSync(marker,'utf8');if(Buffer.from(v,'hex').readBigUInt64LE()===exact){for(const ext of ['rlib','so']){const f=`${base}/deps/lib${name}-${dir.slice(name.length+1)}.${ext}`;if(fs.existsSync(f))found=f;}}}if(!found)throw Error(name);selected[name]=found;}
const rustc='/home/agent/.rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu/bin/rustc';
const library=`${root}/librebase_semantic_proof_current.rlib`;
const common=['--edition','2024','-O','-C','debuginfo=0','-L',`dependency=${base}/deps`,'-L',`native=${repo}/target/g7-environment/lib`];
const args=[...common,'--crate-type','rlib','--crate-name','rebase_semantic_proof','--cfg','feature="default"','--cfg','feature="foundationdb"','--cfg','feature="surrealkv"','-C','metadata=linked_read_study_source1560','--emit',`link,dep-info=${root}/current-source.d`,`${repo}/src/lib.rs`,'-o',library];for(const[name,file]of Object.entries(selected))args.push('--extern',`${name}=${file}`);
let r=spawnSync(rustc,args,{encoding:'utf8',env:{...process.env,CARGO_MANIFEST_DIR:repo,CARGO_PKG_VERSION:'0.16.0'}});process.stdout.write(r.stdout);process.stderr.write(r.stderr);if(r.status!==0)process.exit(r.status??1);
const build={library,selected,args,library_sha256:crypto.createHash('sha256').update(fs.readFileSync(library)).digest('hex')};
const dep=fs.readFileSync(`${root}/current-source.d`,'utf8').split('\n')[0].split(': ')[1].split(' ');build.source=dep.filter(Boolean).map(file=>({file,sha256:crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex')}));fs.writeFileSync(`${root}/current-build-inputs.json`,JSON.stringify(build,null,2));
for(const stem of ['main','page']){const source=`${root}/${stem}.rs`;if(!fs.existsSync(source))continue;const out=stem==='main'?'bench':'page-bench';const args=[...common,'-C','strip=debuginfo',source,'--extern',`rebase_semantic_proof=${library}`];for(const name of ['uuid','serde_json','sha2','foundationdb','futures'])args.push('--extern',`${name}=${selected[name]}`);args.push('-o',`${root}/${out}`);r=spawnSync(rustc,args,{encoding:'utf8'});process.stdout.write(r.stdout);process.stderr.write(r.stderr);if(r.status!==0)process.exit(r.status??1);}
