import { openFdbEnvironment } from '/workspace/ReBase/rebase-next/tools/node/infra.mjs';
import { writeFile, open, rm,stat } from 'node:fs/promises';import fs from'node:fs';import { spawn } from 'node:child_process';
const root='/tmp/rebase-linked-read-study';const sdk='/workspace/ReBase/rebase-next/target/g7-environment';const env={PATH:'/usr/bin:/bin',LD_LIBRARY_PATH:`${sdk}/lib`,HOME:root};const clusterFile=`${root}/fdb-single.cluster`;await writeFile(clusterFile,'linked_single:linkedsingle@127.0.0.1:49501\n',{flag:'wx'});
const owner=await openFdbEnvironment({fdbserver:`${sdk}/upgrade-7.3.77/usr/sbin/fdbserver`,fdbcli:`${sdk}/upgrade-7.3.77/usr/bin/fdbcli`,clusterFile,dataDirectory:`${root}/fdb-single-data`,logDirectory:`${root}/fdb-single-logs`,serverLog:`${root}/fdb-single-server.log`,port:49501,environment:env,startTimeoutMs:20000,commandTimeoutMs:20000});
const result={profile:'single-process-single-ssd',memoryMiB:512,cacheMiB:128,storageMemoryMiB:128,usable_regions:1,errors:[],native:{},page:{},status:[]};let child;
async function cli(command){const c=spawn(`${sdk}/upgrade-7.3.77/usr/bin/fdbcli`,['-C',clusterFile,'--exec',command],{env,stdio:['ignore','pipe','pipe']});let out='',err='';c.stdout.setEncoding('utf8').on('data',x=>out+=x);c.stderr.setEncoding('utf8').on('data',x=>err+=x);await new Promise((resolve,reject)=>{const t=setTimeout(()=>{c.kill('SIGKILL');reject(Error('cli timeout'));},10000);c.on('error',reject);c.on('close',code=>{clearTimeout(t);code===0?resolve():reject(Error(`${code}:${err}`));});});return out;}
async function healthy(){for(let i=0;i<30;i++){const text=await cli('status json');const s=JSON.parse(text);result.status.push(s);if(s.client.database_status.healthy===true&&s.cluster.recovery_state?.seconds_since_last_recovered>=5)return s;await new Promise(r=>setTimeout(r,1000));}throw Error('single cluster unhealthy');}
async function run(binary,stem,key){const stdout=await open(`${root}/${stem}.jsonl`,'w');const stderr=await open(`${root}/${stem}-stderr.log`,'w');try{child=spawn(`${root}/${binary}`,['foundationdb',clusterFile],{env,stdio:['ignore',stdout.fd,stderr.fd]});result[key].pid=child.pid;await new Promise((resolve,reject)=>{let kill;const timer=setTimeout(()=>{result[key].timedOut=true;child.kill('SIGTERM');kill=setTimeout(()=>child.kill('SIGKILL'),10000);},300000);child.on('error',reject);child.on('close',(code,signal)=>{clearTimeout(timer);clearTimeout(kill);result[key].exitCode=code;result[key].signal=signal;code===0?resolve():reject(Error(`${binary} exit${code}/${signal}`));});});}finally{await stdout.close();await stderr.close();}}
function disk(){let size=0;function walk(p){for(const e of fs.readdirSync(p,{withFileTypes:true})){const f=`${p}/${e.name}`;if(e.isDirectory())walk(f);else size+=fs.statSync(f).blocks*512;}}walk(`${root}/fdb-single-data`);return size;}
try{result.start=await owner.start();result.bootstrap=await owner.bootstrap();result.before=await healthy();result.diskBefore=disk();await run('bench','foundationdb-single','native');result.afterNative=await healthy();result.diskAfterNative=disk();await run('page-bench','page-foundationdb-single','page');result.afterPage=await healthy();result.diskAfterPage=disk();}catch(e){result.errors.push(e.stack??String(e));process.exitCode=1;}finally{if(child&&child.exitCode===null&&child.signalCode===null)child.kill('SIGTERM');result.stop=await owner.close();await rm(`${root}/fdb-single-data`,{recursive:true,force:true});await rm(`${root}/fdb-single-logs`,{recursive:true,force:true});await writeFile(`${root}/fdb-single-run.json`,JSON.stringify(result,null,2));}
