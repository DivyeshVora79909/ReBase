use rebase_semantic_proof as p;
use p::{binding::Calculation,native_slice::{Attempt,Input,Record,Result,Error},native_codec::{self,Address,Key,StoredValue},tree::{self,Node,Root,Span,FullKey},indexes::standard::{Standard,Leaf,Aggregate,FINANCIAL},index::{NativeIndex,TimeKey,KeyRange},storage::{self,Database,ReadableTable,TableDefinition},diagnostics::Recorder};
use uuid::Uuid;use serde_json::{json,Value};use sha2::{Sha256,Digest};use std::{time::Instant,ops::Bound,cell::Cell};
const KV:TableDefinition<&[u8],&[u8]>=TableDefinition::new("native_kv");
const ORDER:TableDefinition<&[u8],&[u8]>=TableDefinition::new("research_ordered_entry");
fn uid(rank:usize)->Uuid{let mut h=Sha256::new();h.update(b"linked-read-source-v1");h.update((rank as u64).to_be_bytes());let b=h.finalize();let mut id=[0;16];id.copy_from_slice(&b[..16]);id[6]=(id[6]&15)|64;id[8]=(id[8]&63)|128;Uuid::from_bytes(id)}
fn addr(i:usize)->Address{Address::new(uid(i+100),1)}fn owner()->Address{Address::new(uid(0),2)}
fn at(i:usize)->i64{1000+(i as i64)*17+((i as i64)/7)}
fn ordered_key(i:usize)->Vec<u8>{let mut k=b"p/".to_vec();k.extend_from_slice(&(at(i) as u64).to_be_bytes());k}
fn record(i:usize)->Record{Record{contract:8,tenant:uid(1),owner:uid(2),reader:uid(2),version:uid(3),input:Input::Entry{account:owner().id,at:at(i),amount:1},derived:None}}
fn build_nodes(lo:usize,hi:usize,parent:Option<Address>,n:usize,rows:&mut Vec<(Vec<u8>,Vec<u8>)>)->(Option<Address>,u16,Aggregate){if lo==hi{return(None,0,Standard::empty(FINANCIAL).unwrap());}let m=(lo+hi)/2;let id=addr(m);let(l,lh,ls)=build_nodes(lo,m,Some(id),n,rows);let(r,rh,rs)=build_nodes(m+1,hi,Some(id),n,rows);let leaf=Leaf::Financial(1);let one=Standard::singleton(FINANCIAL,&TimeKey(at(m)),&leaf).unwrap();let summary=Standard::combine(FINANCIAL,&Standard::combine(FINANCIAL,&ls,&one).unwrap(),&rs).unwrap();assert!((lh as i32-rh as i32).abs()<=1);let node=Node::<Standard>{kind:FINANCIAL,root:owner(),key:FullKey{value:TimeKey(at(m)),id:id.id,slot:1},leaf,parent,left:l,right:r,prev:m.checked_sub(1).map(addr),next:(m+1<n).then(||addr(m+1)),height:1+lh.max(rh),span:Span{first:TimeKey(at(lo)),last:TimeKey(at(hi-1))},summary};let key=Key::Node(id);rows.push((key.encode(),native_codec::encode_for::<Calculation>(&key,&StoredValue::Node(node)).unwrap()));(Some(id),1+lh.max(rh),summary)}
fn fixture(n:usize)->Vec<(Vec<u8>,Vec<u8>)>{let mut rows=Vec::with_capacity(2*n+1);let(head,height,summary)=build_nodes(0,n,None,n,&mut rows);let root=Root::<Standard>{kind:FINANCIAL,head,first:Some(addr(0)),last:Some(addr(n-1)),height,span:Some(Span{first:TimeKey(at(0)),last:TimeKey(at(n-1))}),summary,revision:uid(4)};let key=Key::Root(owner());rows.push((key.encode(),native_codec::encode_for::<Calculation>(&key,&StoredValue::Root(root)).unwrap()));for i in 0..n{let key=Key::Record(addr(i).id);rows.push((key.encode(),native_codec::encode_for::<Calculation>(&key,&StoredValue::Record(record(i))).unwrap()));}rows}
fn err(e:impl std::fmt::Display)->Error{Error::new("storage",e.to_string())}
fn seed(db:&Database,n:usize,rows:&[(Vec<u8>,Vec<u8>)]){for batch in rows.chunks(500){let tx=db.begin_write().unwrap();{let mut table=tx.open_table(KV).unwrap();for(k,v)in batch{table.insert(k.as_slice(),v.as_slice()).unwrap();}}tx.commit().unwrap();}for lo in (0..n).step_by(500){let tx=db.begin_write().unwrap();{let mut table=tx.open_table(ORDER).unwrap();for i in lo..(lo+500).min(n){let value=native_codec::encode_for::<Calculation>(&Key::Record(addr(i).id),&StoredValue::Record(record(i))).unwrap();table.insert(ordered_key(i).as_slice(),value.as_slice()).unwrap();}}tx.commit().unwrap();}}
fn operation(db:&Database,backend:&str,n:usize,q:usize,start:usize,op:&str,diagnostic:bool)->Result<Value>{let trace=Recorder::new("linked-read","sample",backend,op,"read");let tx=if diagnostic{db.begin_read_diagnostic(trace.clone())}else{db.begin_read()}.map_err(err)?;let table=tx.open_table(KV).map_err(err)?;let key_bytes=Cell::new(0u64);let value_bytes=Cell::new(0u64);let loader=|key:&[u8]|{let v=table.get(key).map_err(err)?.map(|v|v.value().to_vec());key_bytes.set(key_bytes.get()+key.len() as u64);value_bytes.set(value_bytes.get()+v.as_ref().map_or(0,|v|v.len() as u64));Ok(v)};let mut ws:Attempt<_,Calculation>=if diagnostic{Attempt::new_diagnostic(loader,1_000_000,trace.clone())}else{Attempt::new(loader,1_000_000)};let mut output=Vec::new();let mut continuation=None;
 match op{
 "linked_ids"|"linked_hydrate"=>{let r=tree::root(&mut ws,owner())?;let mut cursor=if start==0{r.first}else{let mut search=r.head;let mut best=None;while let Some(id)=search{let node=tree::node(&mut ws,owner(),id)?;if node.key.value>=TimeKey(at(start)){best=Some(id);search=node.left;}else{search=node.right;}}best};for i in start..start+q{let id=cursor.ok_or_else(||Error::new("fixture","early chain end"))?;let node=tree::node(&mut ws,owner(),id)?;assert_eq!(id,addr(i));assert_eq!(node.key.value,TimeKey(at(i)));assert_eq!(node.prev,i.checked_sub(1).map(addr));if op=="linked_hydrate"{assert_eq!(ws.record(id.id)?,Some(record(i)));}output.push(id.id);cursor=node.next;}continuation=cursor;assert_eq!(cursor,(start+q<n).then(||addr(start+q)));},
 "summary_range"=>{let summary=tree::range_keys(&mut ws,owner(),&KeyRange{lower:Bound::Included(TimeKey(at(start))),upper:Bound::Included(TimeKey(at(start+q-1)))})?;match summary{Aggregate::Financial(s)=>{assert_eq!(s.count,q as u64);assert_eq!(s.sum,q as i128);},_=>panic!()}},
 "summary_prefix"=>{let sum=tree::prefix(&mut ws,owner(),Some(at(start+q)))?;assert_eq!(sum,(start+q) as i128);},
 "raw_ordered_range"=>{let ordered=tx.open_table(ORDER).map_err(err)?;let lo=ordered_key(start);let hi=if start+q<n{ordered_key(start+q)}else{b"p0".to_vec()};for (i,row)in ordered.range(lo.as_slice()..hi.as_slice()).map_err(err)?.enumerate(){let(k,v)=row.map_err(err)?;assert_eq!(k.value(),ordered_key(start+i));let value=v.value();let decoded=native_codec::decode_for::<Calculation>(&Key::Record(addr(start+i).id),value)?;assert_eq!(decoded,StoredValue::Record(record(start+i)));output.push(addr(start+i).id);}assert_eq!(output.len(),q);},_=>panic!()}
 let hash=hex_hash(&output);let mut result=json!({"attempt":{"key_loads":ws.work.key_loads,"loaded_bytes":ws.work.loaded_bytes,"node_visits":ws.work.node_visits},"loader_key_bytes":key_bytes.get(),"loader_value_bytes":value_bytes.get(),"result_sha256":hash,"result_rows":output.len(),"continuation":continuation.map(|v|v.id.to_string())});if diagnostic{let t=trace.snapshot("success",0,None);result["diagnostic"]=json!({"counters":t.counters,"complete":t.complete,"incompleteReasons":t.incomplete_reasons,"dependency":t.dependency});}Ok(result)}
fn hex_hash(ids:&[Uuid])->String{let mut h=Sha256::new();for id in ids{h.update(id.as_bytes());}format!("{:x}",h.finalize())}
fn run(db:&Database,backend:&str,n:usize){for q in [50usize,100,1000,10000]{if q>n{continue;}for start in [0,n-q]{for op in ["linked_ids","linked_hydrate","raw_ordered_range"]{sample(db,backend,n,q,start,op);}}}for(start,q)in [(0,n),(n/3,n/3)]{for op in ["summary_range","summary_prefix"]{sample(db,backend,n,q,start,op);}}}
fn sample(db:&Database,backend:&str,n:usize,q:usize,start:usize,op:&str){let mut samples=Vec::new();let warm=operation(db,backend,n,q,start,op,false);if let Err(e)=warm{println!("{}",json!({"backend":backend,"n":n,"q":q,"start":start,"op":op,"status":"error","phase":"warmup","error":e.to_string()}));return;}let mut last=Value::Null;for _ in 0..3{let begin=Instant::now();match operation(db,backend,n,q,start,op,false){Ok(result)=>{samples.push(begin.elapsed().as_nanos() as u64);last=result},Err(e)=>{println!("{}",json!({"backend":backend,"n":n,"q":q,"start":start,"op":op,"status":"error","phase":"timed","samples_ns":samples,"error":e.to_string()}));return;}}}let diag=operation(db,backend,n,q,start,op,true);let mut sorted=samples.clone();sorted.sort_unstable();let mut out=json!({"backend":backend,"n":n,"q":q,"start":start,"op":op,"status":"passed","median_ns":sorted[1],"samples_ns":samples,"observation":last});match diag{Ok(v)=>out["diagnostic"]=v["diagnostic"].clone(),Err(e)=>out["diagnostic_error"]=json!(e.to_string())};println!("{out}");}
fn main(){let args:Vec<_>=std::env::args().collect();let backend=&args[1];let _network=(backend=="foundationdb").then(||unsafe{foundationdb::boot()});for n in [10000usize,100000]{let rows=fixture(n);let mut h=Sha256::new();let mut total=0;for(k,v)in &rows{h.update((k.len()as u64).to_be_bytes());h.update(k);h.update((v.len()as u64).to_be_bytes());h.update(v);total+=v.len();}println!("{}",json!({"fixture":"native-AVL-and-Entry","n":n,"rows":rows.len(),"encoded_value_bytes":total,"entry_encoded_bytes":native_codec::encode_for::<Calculation>(&Key::Record(addr(0).id),&StoredValue::Record(record(0))).unwrap().len(),"sha256":format!("{:x}",h.finalize()),"population_caps_bypassed_fixture_only":true}));let path=format!("/tmp/rebase-linked-read-study/{backend}-{n}");let db=match backend.as_str(){"redb"=>Database::create(&path).unwrap(),"surrealkv"=>storage::surrealkv::connect(&path).unwrap(),"foundationdb"=>storage::foundationdb::connect(Some(&args[2]),format!("linked-read-{n}").as_bytes()).unwrap(),_=>panic!()};seed(&db,n,&rows);drop(rows);run(&db,backend,n);drop(db);if backend=="redb"{std::fs::remove_file(path).unwrap();}else if backend=="surrealkv"{std::fs::remove_dir_all(path).unwrap();}}
}
