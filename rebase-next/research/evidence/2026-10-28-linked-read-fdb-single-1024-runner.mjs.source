#!/usr/bin/env node
// Owns a disposable, three-process FoundationDB 7.3.77 cluster for one native run.
// Run from Node 24. This file intentionally does not start any pre-existing process.

import { spawn } from 'node:child_process';
import { createServer } from 'node:net';
import { access, mkdir, open, rm, writeFile } from 'node:fs/promises';
import path from 'node:path';
import fs from 'node:fs';
function ownedDisk(){let logical=0,allocated=0;function visit(p){for(const e of fs.readdirSync(p,{withFileTypes:true})){const f=path.join(p,e.name);if(e.isDirectory())visit(f);else{const st=fs.statSync(f);logical+=st.size;allocated+=st.blocks*512;}}}for(let i=1;i<=1;i++)for(const k of['data','logs'])visit(path.join(root,`fdb1024-${k}-${i}`));return{logical_bytes:logical,allocated_bytes:allocated};}

const root = '/tmp/rebase-linked-read-study';
const sdk = '/workspace/ReBase/rebase-next/target/g7-environment/upgrade-7.3.77/usr';
const serverBin = `${sdk}/sbin/fdbserver`;
const cliBin = `${sdk}/bin/fdbcli`;
const nativeBin = path.join(root, 'bench');
const pageNativeBin = path.join(root, 'page-bench');
const clusterFile = path.join(root, 'fdb1024.cluster');
const coordinator = '127.0.0.1:49511';
const description = 'linkedstudy1024';
const clusterConnection = `${description}:${description}@${coordinator}`;
const resultFile = path.join(root, 'foundationdb-single-1024.jsonl');
const resultErr = path.join(root, 'foundationdb-single-1024.stderr.log');
const metadataFile = path.join(root, 'fdb-single-1024-run.json');
const deadlineMs = 5 * 60 * 1000;
const env = {
  PATH: '/usr/bin:/bin',
  LD_LIBRARY_PATH: '/workspace/ReBase/rebase-next/target/g7-environment/lib',
  HOME: root,
};

const children = [];
const result = {
  profile:"one-local-process-single-ssd-1024MiB",memoryMiB:1024,cacheMiB:64,storageMemoryMiB:64,
  cluster: clusterConnection,
  clusterFile,
  versions: {},
  status: null,
  configuration: null,
  topology: null,
  processes: [],
  native: { stdout: resultFile, stderr: resultErr, exitCode: null, signal: null, timedOut: false },
  pageNative: { stdout: path.join(root, 'page-foundationdb-single-1024.jsonl'), stderr: path.join(root, 'page-foundationdb-single-1024.stderr.log'), exitCode: null, signal: null, timedOut: false, skipped: false },
  errors: [],
};

function delay(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

async function startOwned(name, bin, args, stdoutPath, stderrPath) {
  const out = await open(stdoutPath, 'a');
  const err = await open(stderrPath, 'a');
  const child = spawn(bin, args, { env, cwd: root, stdio: ['ignore', out.fd, err.fd] });
  const entry = { name, pid: child.pid ?? null, child, stdoutPath, stderrPath, exited: false, exitCode: null, signal: null };
  children.push(entry);
  entry.streamsReady = Promise.resolve();
  entry.outputHandles = [out, err];
  entry.closed = new Promise(resolve => child.once('close', (code, signal) => {
    entry.exited = true;
    entry.exitCode = code;
    entry.signal = signal;
    resolve({ code, signal });
  }));
  child.once('error', error => { entry.spawnError = error.message; });
  return entry;
}

async function runCli(command, timeoutMs = 10000) {
  return await new Promise((resolve, reject) => {
    const child = spawn(cliBin, ['-C', clusterFile, '--exec', command], { env, cwd: root, stdio: ['ignore', 'pipe', 'pipe'] });
    let stdout = '';
    let stderr = '';
    const timer = setTimeout(() => {
      child.kill('SIGKILL');
      reject(new Error(`fdbcli timed out: ${command}`));
    }, timeoutMs);
    child.stdout.setEncoding('utf8').on('data', chunk => { stdout += chunk; });
    child.stderr.setEncoding('utf8').on('data', chunk => { stderr += chunk; });
    child.once('error', error => { clearTimeout(timer); reject(error); });
    child.once('close', code => {
      clearTimeout(timer);
      if (code !== 0) reject(new Error(`fdbcli ${command} exited ${code}: ${stderr || stdout}`));
      else resolve({ stdout, stderr });
    });
  });
}

async function terminateOwned() {
  const live = children.filter(entry => !entry.exited && entry.child.pid);
  for (const entry of live) entry.child.kill('SIGTERM');
  if (live.length) {
    const allClosed = Promise.all(live.map(entry => entry.closed));
    await Promise.race([allClosed, delay(10000)]);
  }
  for (const entry of children.filter(item => !item.exited && item.child.pid)) entry.child.kill('SIGKILL');
  await Promise.all(children.map(entry => entry.closed.catch(() => {})));
  await Promise.all(children.map(entry => entry.streamsReady?.catch(() => {})));
  await Promise.all(children.flatMap(entry => (entry.outputHandles ?? []).map(handle => handle.close().catch(() => {}))));
}

async function snapshot() {
  const attempts = 30;
  let lastError;
  for (let i = 0; i < attempts; i++) {
    try {
      const status = await runCli('status json', 5000);
      result.status = status.stdout;
      try { result.topology = JSON.parse(status.stdout); }
      catch { result.topology = status.stdout; }
      if (result.topology && typeof result.topology === 'object') {
        result.configuration = result.topology.cluster?.configuration ?? null;
        result.versions = Object.fromEntries(Object.values(result.topology.cluster?.processes ?? {})
          .filter(proc => proc.address && proc.version)
          .map(proc => [proc.address, proc.version]));
        if (result.topology.client?.database_status?.available !== true) throw new Error('status reports database unavailable');
        if (result.topology.client?.database_status?.healthy !== true) throw new Error('status reports database unhealthy');
        if (result.topology.cluster?.recovery_state?.name !== 'fully_recovered' || result.topology.cluster.recovery_state.seconds_since_last_recovered < 5) throw new Error('recovery not stable for5s');
        const processes=Object.values(result.topology.cluster.processes??{});
        const roles=processes.flatMap(p=>p.roles??[]);
        if(processes.length!==1 || roles.filter(r=>r.role==='storage').length<1 || roles.filter(r=>r.role==='log').length<1) throw new Error('three storage/log roles not ready');
        if(processes.some(p=>(p.messages??[]).length)) throw new Error('process warning messages');
        const config = result.configuration;
        if (config?.redundancy_mode !== 'single' || !String(config?.storage_engine ?? '').startsWith('ssd')) {
          throw new Error(`unexpected cluster configuration: ${JSON.stringify(config)}`);
        }
      } else {
        throw new Error('status json did not parse as an object');
      }
      return;
    } catch (error) {
      lastError = error;
      await delay(1000);
    }
  }
  throw new Error(`cluster did not become available within ~30 seconds: ${lastError?.message ?? 'unknown error'}`);
}

async function assertPortFree(port) {
  await new Promise((resolve, reject) => {
    const probe = createServer();
    probe.once('error', error => reject(new Error(`127.0.0.1:${port} is unavailable: ${error.message}`)));
    probe.listen(port, '127.0.0.1', () => probe.close(error => error ? reject(error) : resolve()));
  });
}

async function runNative(name, bin, stdoutPath, stderrPath) {
  const stdout = await open(stdoutPath, 'w');
  const stderr = await open(stderrPath, 'w');
  const child = spawn(bin, ['foundationdb', clusterFile], { env, cwd: root, stdio: ['ignore', stdout.fd, stderr.fd] });
  const record = result[name];
  const entry = { name, child, pid: child.pid ?? null, exited: false, outputHandles: [stdout, stderr], closed: new Promise(resolve => child.once('close', (code, signal) => {
    record.exitCode = code;
    record.signal = signal;
    entry.exited = true;
    resolve();
  })) };
  children.push(entry);
  child.once('error', error => result.errors.push(`${name}: ${error.message}`));
  const deadline = setTimeout(() => {
    record.timedOut = true;
    child.kill('SIGTERM');
    entry.killTimer = setTimeout(() => child.kill('SIGKILL'), 10000);
  }, deadlineMs);
  await entry.closed;
  clearTimeout(deadline);
  clearTimeout(entry.killTimer);
  await Promise.all([stdout.close(), stderr.close()]);
  return record.exitCode;
}

async function main() {
  await mkdir(root, { recursive: true });
  const ownedDirs = [];
  for (let i = 1; i <= 1; i++) {
    for (const kind of ['data', 'logs']) {
      const dir = path.join(root, `fdb1024-${kind}-${i}`);
      await mkdir(dir, { recursive: false });
      ownedDirs.push(dir);
    }
  }
  await writeFile(clusterFile, `${clusterConnection}\n`, { flag: 'wx' });
  try {
    for (let port = 49491; port <= 49493; port++) await assertPortFree(port);
    for (let i = 1; i <= 1; i++) {
      const port = 49510 + i;
      const dataDir = path.join(root, `fdb1024-data-${i}`);
      const logDir = path.join(root, `fdb1024-logs-${i}`);
      const entry = await startOwned(`fdbserver-${i}`, serverBin, [
        '-p', `127.0.0.1:${port}`, '-C', clusterFile,
        '-m', '1024', '--cache-memory', '64', '--storage-memory', '64',
        '-d', dataDir, '-L', logDir,
        '--locality-zoneid', `linked_zone_${i}`,
        '--locality-machineid', `linked_machine_${i}`,
      ], path.join(root, `fdb1024-server-${i}.stdout.log`), path.join(root, `fdb1024-server-${i}.stderr.log`));
      await entry.streamsReady;
      result.processes.push({ name: entry.name, pid: entry.pid, port, zoneid: `linked_zone_${i}`, machineid: `linked_machine_${i}`, stdout: entry.stdoutPath, stderr: entry.stderrPath });
    }
    await writeFile(metadataFile, JSON.stringify(result, null, 2));
    await delay(1500);
    await runCli('configure new single ssd', 20000);
    await snapshot();
    await writeFile(metadataFile, JSON.stringify(result, null, 2));

    result.statusBeforeData=result.status;result.diskBeforeData=ownedDisk();
    const benchExitCode = await runNative('native', nativeBin, result.native.stdout, result.native.stderr);
    result.diskAfterNative=ownedDisk();
    if(benchExitCode===0){await snapshot();result.statusAfterNative=result.status;}
    if (benchExitCode === 0) {
      let pageAvailable = true;
      try { await access(pageNativeBin); }
      catch (error) {
        if (error?.code === 'ENOENT') pageAvailable = false;
        else throw error;
      }
      if (pageAvailable) {
        await runNative('pageNative', pageNativeBin, result.pageNative.stdout, result.pageNative.stderr);
        result.diskAfterPage=ownedDisk();
        await snapshot();result.statusAfterPage=result.status;
      } else {
        result.pageNative.skipped = true;
        result.errors.push('page-bench was not present; page benchmark skipped');
      }
    } else {
      result.pageNative.skipped = true;
      result.errors.push(`page-bench skipped because bench exited ${benchExitCode}`);
    }
  } catch (error) {
    result.errors.push(error?.stack ?? String(error));
    process.exitCode = 1;
  } finally {
    await terminateOwned();
    for (const dir of ownedDirs) await rm(dir, { recursive: true, force: true }).catch(error => result.errors.push(`cleanup ${dir}: ${error.message}`));
    result.processes = result.processes.map(proc => {
      const entry = children.find(item => item.name === proc.name);
      return { ...proc, exitCode: entry?.exitCode ?? null, signal: entry?.signal ?? null };
    });
    await writeFile(metadataFile, JSON.stringify(result, null, 2)).catch(() => {});
  }
}

await main();
