use rebase_semantic_proof as p;
use p::{binding::Calculation,native_slice::{Attempt,Input,Record,Result,Error,Work},native_codec::{self,Address,Key,StoredValue},tree::{self,Node,Root,Span,FullKey},indexes::standard::{Standard,Leaf,Aggregate,FINANCIAL},index::{NativeIndex,TimeKey,KeyRange},storage::{self,Database,ReadableTable,TableDefinition},diagnostics::Recorder};
use uuid::Uuid;use serde_json::{json,Value};use sha2::{Sha256,Digest};use std::{time::Instant,ops::Bound,cell::Cell};
const KV:TableDefinition<&[u8],&[u8]>=TableDefinition::new("native_kv");const ORDER:TableDefinition<&[u8],&[u8]>=TableDefinition::new("research_ordered_entry");
fn uid(rank:usize)->Uuid{let mut h=Sha256::new();h.update(b"linked-read-source-v1");h.update((rank as u64).to_be_bytes());let b=h.finalize();let mut id=[0;16];id.copy_from_slice(&b[..16]);id[6]=(id[6]&15)|64;id[8]=(id[8]&63)|128;Uuid::from_bytes(id)}
fn at(i:usize)->i64{1000+(i as i64)*17+((i as i64)/7)}
struct Fixture{n:usize,owner:Address,addresses:Vec<Address>,times:Vec<i64>,records:Vec<Record>,ordered_keys:Vec<Vec<u8>>,rows:Vec<(Vec<u8>,Vec<u8>)>,record_bytes:Vec<Vec<u8>>}
fn build_nodes(f:&Fixture,lo:usize,hi:usize,parent:Option<Address>,rows:&mut Vec<(Vec<u8>,Vec<u8>)>)->(Option<Address>,u16,Aggregate){if lo==hi{return(None,0,Standard::empty(FINANCIAL).unwrap());}let m=(lo+hi)/2;let id=f.addresses[m];let(l,lh,ls)=build_nodes(f,lo,m,Some(id),rows);let(r,rh,rs)=build_nodes(f,m+1,hi,Some(id),rows);let leaf=Leaf::Financial(1);let one=Standard::singleton(FINANCIAL,&TimeKey(f.times[m]),&leaf).unwrap();let summary=Standard::combine(FINANCIAL,&Standard::combine(FINANCIAL,&ls,&one).unwrap(),&rs).unwrap();assert!((lh as i32-rh as i32).abs()<=1);if let Aggregate::Financial(s)=summary{assert_eq!(s.count,(hi-lo)as u64);assert_eq!(s.sum,(hi-lo)as i128);}else{panic!()};let node=Node::<Standard>{kind:FINANCIAL,root:f.owner,key:FullKey{value:TimeKey(f.times[m]),id:id.id,slot:1},leaf,parent,left:l,right:r,prev:m.checked_sub(1).map(|i|f.addresses[i]),next:(m+1<f.n).then(||f.addresses[m+1]),height:1+lh.max(rh),span:Span{first:TimeKey(f.times[lo]),last:TimeKey(f.times[hi-1])},summary};let key=Key::Node(id);rows.push((key.encode(),native_codec::encode_for::<Calculation>(&key,&StoredValue::Node(node)).unwrap()));(Some(id),1+lh.max(rh),summary)}
fn fixture(n:usize)->Fixture{let owner=Address::new(uid(0),2);let addresses:Vec<_>=(0..n).map(|i|Address::new(uid(i+100),1)).collect();let times:Vec<_>=(0..n).map(at).collect();let records:Vec<_>=(0..n).map(|i|Record{contract:8,tenant:uid(1),owner:uid(2),reader:uid(2),version:uid(3),input:Input::Entry{account:owner.id,at:times[i],amount:1},derived:None}).collect();let ordered_keys=(0..n).map(|i|{let mut k=b"p/".to_vec();k.extend_from_slice(&(times[i]as u64).to_be_bytes());k.extend_from_slice(addresses[i].id.as_bytes());k.extend_from_slice(&1u16.to_be_bytes());k}).collect();let record_bytes=(0..n).map(|i|native_codec::encode_for::<Calculation>(&Key::Record(addresses[i].id),&StoredValue::Record(records[i].clone())).unwrap()).collect();let mut f=Fixture{n,owner,addresses,times,records,ordered_keys,rows:Vec::new(),record_bytes};let mut rows=Vec::with_capacity(2*n+1);let(head,height,summary)=build_nodes(&f,0,n,None,&mut rows);let root=Root::<Standard>{kind:FINANCIAL,head,first:Some(f.addresses[0]),last:Some(f.addresses[n-1]),height,span:Some(Span{first:TimeKey(f.times[0]),last:TimeKey(f.times[n-1])}),summary,revision:uid(4)};let key=Key::Root(owner);rows.push((key.encode(),native_codec::encode_for::<Calculation>(&key,&StoredValue::Root(root)).unwrap()));for i in 0..n{rows.push((Key::Record(f.addresses[i].id).encode(),f.record_bytes[i].clone()));}f.rows=rows;f}
fn err(e:impl std::fmt::Display)->Error{Error::new("storage",e.to_string())}
fn seed(db:&Database,f:&Fixture){for batch in f.rows.chunks(500){let tx=db.begin_write().unwrap();{let mut table=tx.open_table(KV).unwrap();for(k,v)in batch{table.insert(k.as_slice(),v.as_slice()).unwrap();}}tx.commit().unwrap();}for lo in (0..f.n).step_by(500){let tx=db.begin_write().unwrap();{let mut table=tx.open_table(ORDER).unwrap();for i in lo..(lo+500).min(f.n){table.insert(f.ordered_keys[i].as_slice(),f.record_bytes[i].as_slice()).unwrap();}}tx.commit().unwrap();}}
struct Fetch{ids:Vec<Uuid>,records:Vec<Record>,summary:Option<Aggregate>,prefix:Option<i128>,continuation:Option<Address>,work:Work,key_bytes:u64,value_bytes:u64}
fn operation(db:&Database,f:&Fixture,q:usize,start:usize,op:&str,trace:Option<Recorder>)->Result<Fetch>{let tx=if let Some(t)=&trace{db.begin_read_diagnostic(t.clone())}else{db.begin_read()}.map_err(err)?;let table=if op=="raw_ordered_range"{None}else{Some(tx.open_table(KV).map_err(err)?)};let key_bytes=Cell::new(0u64);let value_bytes=Cell::new(0u64);let loader=|key:&[u8]|{let v=table.as_ref().expect("native point path").get(key).map_err(err)?.map(|v|v.value().to_vec());key_bytes.set(key_bytes.get()+key.len()as u64);value_bytes.set(value_bytes.get()+v.as_ref().map_or(0,|v|v.len()as u64));Ok(v)};let mut ws:Attempt<_,Calculation>=if let Some(t)=trace{Attempt::new_diagnostic(loader,1_000_000,t)}else{Attempt::new(loader,1_000_000)};let mut ids=Vec::new();let mut records=Vec::new();let mut continuation=None;let mut summary=None;let mut prefix=None;
match op{
"linked_ids"|"linked_hydrate"=>{let r=tree::root(&mut ws,f.owner)?;let mut cursor=if start==0{r.first}else{let mut search=r.head;let mut best=None;while let Some(id)=search{let node=tree::node(&mut ws,f.owner,id)?;if node.key.value>=TimeKey(f.times[start]){best=Some(id);search=node.left;}else{search=node.right;}}best};for _ in 0..q{let id=cursor.ok_or_else(||Error::new("fixture","early chain end"))?;let node=tree::node(&mut ws,f.owner,id)?;if op=="linked_hydrate"{records.push(ws.record(id.id)?.ok_or_else(||Error::new("fixture","missing record"))?);}ids.push(id.id);cursor=node.next;}continuation=cursor;},
"summary_range"=>summary=Some(tree::range_keys(&mut ws,f.owner,&KeyRange{lower:Bound::Included(TimeKey(f.times[start])),upper:Bound::Included(TimeKey(f.times[start+q-1]))})?),
"summary_prefix"=>prefix=Some(tree::prefix(&mut ws,f.owner,Some(at(start+q)))?),
"raw_ordered_range"=>{let ordered=tx.open_table(ORDER).map_err(err)?;let hi=if start+q<f.n{f.ordered_keys[start+q].as_slice()}else{b"p0"};for row in ordered.range(f.ordered_keys[start].as_slice()..hi).map_err(err)?{let(k,v)=row.map_err(err)?;let id=Uuid::from_slice(&k.value()[10..26]).map_err(err)?;let decoded=native_codec::decode_for::<Calculation>(&Key::Record(id),v.value())?;let StoredValue::Record(r)=decoded else{return Err(Error::new("fixture","range record kind"));};ids.push(id);records.push(r);}},_=>panic!()}
Ok(Fetch{ids,records,summary,prefix,continuation,work:ws.work.clone(),key_bytes:key_bytes.get(),value_bytes:value_bytes.get()})}
fn verify(fetch:&Fetch,f:&Fixture,q:usize,start:usize,op:&str)->Value{if op.starts_with("linked_")||op=="raw_ordered_range"{let expected:Vec<_>=f.addresses[start..start+q].iter().map(|a|a.id).collect();assert_eq!(fetch.ids,expected);if op!="linked_ids"{assert_eq!(fetch.records,f.records[start..start+q]);}if op.starts_with("linked_"){assert_eq!(fetch.continuation,(start+q<f.n).then(||f.addresses[start+q]));}}if let Some(Aggregate::Financial(s))=fetch.summary{assert_eq!(s.count,q as u64);assert_eq!(s.sum,q as i128);}if let Some(sum)=fetch.prefix{assert_eq!(sum,(start+q)as i128);}let mut h=Sha256::new();for id in &fetch.ids{h.update(id.as_bytes());}if let Some(s)=fetch.summary{h.update(serde_json::to_vec(&s).unwrap());}if let Some(sum)=fetch.prefix{h.update(sum.to_be_bytes());}json!({"attempt":{"key_loads":fetch.work.key_loads,"loaded_bytes":fetch.work.loaded_bytes,"node_visits":fetch.work.node_visits},"loader_key_bytes":fetch.key_bytes,"loader_value_bytes":fetch.value_bytes,"result_sha256":format!("{:x}",h.finalize()),"result_rows":fetch.ids.len(),"hydrated_records":fetch.records.len(),"continuation":fetch.continuation.map(|a|a.id.to_string())})}
fn sample(db:&Database,backend:&str,f:&Fixture,q:usize,start:usize,op:&str){let n=f.n;let warm=operation(db,f,q,start,op,None);match warm{Ok(v)=>{verify(&v,f,q,start,op);},Err(e)=>{println!("{}",json!({"backend":backend,"n":n,"q":q,"start":start,"op":op,"status":"error","phase":"warmup","error":e.to_string()}));return;}}let mut samples=Vec::new();let mut observations=Vec::new();for _ in 0..3{let begin=Instant::now();let result=operation(db,f,q,start,op,None);let elapsed=begin.elapsed().as_nanos()as u64;match result{Ok(result)=>{samples.push(elapsed);observations.push(verify(&result,f,q,start,op));},Err(e)=>{println!("{}",json!({"backend":backend,"n":n,"q":q,"start":start,"op":op,"status":"error","phase":"timed","samples_ns":samples,"error_elapsed_ns":elapsed,"error":e.to_string()}));return;}}}assert!(observations.windows(2).all(|v|v[0]==v[1]));let trace=Recorder::new("linked-read","diagnostic",backend,op,"read");trace.seed_invocation(&Key::Root(f.owner).encode());let diagnostic=operation(db,f,q,start,op,Some(trace.clone()));let mut sorted=samples.clone();sorted.sort_unstable();let mut out=json!({"backend":backend,"n":n,"q":q,"start":start,"op":op,"status":"passed","median_ns":sorted[1],"samples_ns":samples,"observation":observations[0]});match diagnostic{Ok(v)=>{assert_eq!(verify(&v,f,q,start,op),observations[0]);let t=trace.snapshot("success",0,None);out["diagnostic"]=json!({"counters":t.counters,"complete":t.complete,"incompleteReasons":t.incomplete_reasons,"dependency":t.dependency});},Err(e)=>out["diagnostic_error"]=json!(e.to_string())};println!("{out}");}
fn run(db:&Database,backend:&str,f:&Fixture){for q in [50usize,100,1000,10000]{if q>f.n{continue;}let mut starts=vec![0,f.n-q];starts.dedup();for start in starts{for op in ["linked_ids","linked_hydrate","raw_ordered_range"]{sample(db,backend,f,q,start,op);}}}for(start,q)in [(0,f.n),(f.n/3,f.n/3)]{for op in ["summary_range","summary_prefix"]{sample(db,backend,f,q,start,op);}}}
fn main(){let args:Vec<_>=std::env::args().collect();let backend=&args[1];let _network=(backend=="foundationdb").then(||unsafe{foundationdb::boot()});for n in [10000usize,100000]{let f=fixture(n);let mut h=Sha256::new();let mut total=0;for(k,v)in &f.rows{h.update((k.len()as u64).to_be_bytes());h.update(k);h.update((v.len()as u64).to_be_bytes());h.update(v);total+=v.len();}println!("{}",json!({"fixture":"native-AVL-and-Entry","n":n,"rows":f.rows.len(),"encoded_value_bytes":total,"entry_encoded_bytes":f.record_bytes[0].len(),"ordered_key_bytes":28,"sha256":format!("{:x}",h.finalize()),"population_caps_bypassed_fixture_only":true,"oracle_and_output_checksum_outside_timed_span":true}));let path=format!("/tmp/rebase-linked-read-study/{backend}-{n}");let db=match backend.as_str(){"redb"=>Database::create(&path).unwrap(),"surrealkv"=>storage::surrealkv::connect(&path).unwrap(),"foundationdb"=>storage::foundationdb::connect(Some(&args[2]),format!("linked-read-{n}").as_bytes()).unwrap(),_=>panic!()};seed(&db,&f);run(&db,backend,&f);drop(db);if backend=="redb"{std::fs::remove_file(path).unwrap();}else if backend=="surrealkv"{std::fs::remove_dir_all(path).unwrap();}}
}
