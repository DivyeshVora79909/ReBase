import fs from'node:fs';import{spawnSync}from'node:child_process';import crypto from'node:crypto';
const root='/tmp/rebase-linked-read-study';const {selected,library}=JSON.parse(fs.readFileSync(`${root}/current-build-inputs.json`));const inputs=[];
for(const stem of['main','page']){const source=`${root}/${stem}.rs`;const out=stem==='main'?'bench':'page-bench';const args=['--edition','2024','-O','-C','debuginfo=0','-C','strip=debuginfo',source,'-L','dependency=/workspace/ReBase/rebase-next/target/verification-build/release/deps','-L','native=/workspace/ReBase/rebase-next/target/g7-environment/lib','--extern',`rebase_semantic_proof=${library}`];for(const name of['uuid','serde_json','sha2','foundationdb','futures'])args.push('--extern',`${name}=${selected[name]}`);args.push('-o',`${root}/${out}`);const r=spawnSync('/home/agent/.rustup/toolchains/1.95.0-x86_64-unknown-linux-gnu/bin/rustc',args,{encoding:'utf8'});process.stdout.write(r.stdout);process.stderr.write(r.stderr);if(r.status!==0)process.exit(r.status??1);inputs.push({source,source_sha256:crypto.createHash('sha256').update(fs.readFileSync(source)).digest('hex'),args,binary_sha256:crypto.createHash('sha256').update(fs.readFileSync(`${root}/${out}`)).digest('hex')});}fs.writeFileSync(`${root}/harness-build-inputs.json`,JSON.stringify(inputs,null,2));
