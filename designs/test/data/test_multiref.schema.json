{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "a_name", "a_creator", "a_owning_group"],
  "properties": {
    "id": { "type": "string", "pattern": "^test_multiref:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "a_name": { "type": "string", "minLength": 2 },
    "a_creator": { "type": "string", "pattern": "^user:[a-z0-9-]+$" },
    "a_reviewer": { "type": "string", "pattern": "^user:[a-z0-9-]+$" },
    "a_approver": { "type": "string", "pattern": "^user:[a-z0-9-]+$" },
    "a_owning_group": { "type": "string", "pattern": "^groups:[a-z0-9-]+$" },
    "a_auditing_group": { "type": "string", "pattern": "^groups:[a-z0-9-]+$" }
  }
}
