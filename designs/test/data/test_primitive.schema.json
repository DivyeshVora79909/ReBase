{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "a_string", "a_decimal", "a_datetime"],
  "properties": {
    "id": { "type": "string", "pattern": "^test_primitive:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "a_string": { "type": "string", "minLength": 2 },
    "a_int": { "type": "integer", "default": 0 },
    "a_decimal": { "type": "number", "minimum": 0 },
    "a_bool": { "type": "boolean", "default": false },
    "a_datetime": { "type": "string", "format": "date-time" },
    "a_object": { "type": "object", "default": {} },
    "a_enum": {
      "enum": ["pending", "active", "archived"],
      "default": "pending"
    }
  }
}
