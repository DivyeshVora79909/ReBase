{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "a_string", "a_decimal", "a_datetime"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
    "a_string": { "type": "string", "minLength": 2 },
    "a_int": { "type": "integer", "minimum": -100, "maximum": 100 },
    "a_decimal": {"type": "string", "pattern": "^[0-9]{1,4}(?:\\.[0-9]{1,2})?$"},
    "a_bool": { "type": "boolean" },
    "a_datetime": { "type": "string", "format": "date-time" },
    "a_object": { "type": "object", "maxProperties": 4 },
    "a_enum": {
      "enum": ["pending", "active", "archived"]
    }
  }
}
