{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "label", "from_email", "from_name", "api_key"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "label": { "type": "string", "minLength": 2 },
    "visibility": { "type": "boolean", "x-rebase-optional-probability": 0.45 },
    "from_email": { "type": "string", "format": "email" },
    "from_name": { "type": "string", "minLength": 2 },
    "reply_to": { "type": "string", "format": "email", "x-rebase-optional-probability": 0.35 },
    "api_key": { "type": "string", "minLength": 1 },
    "compliance_note": { "type": "string", "x-rebase-optional-probability": 0.25 }
  }
}
