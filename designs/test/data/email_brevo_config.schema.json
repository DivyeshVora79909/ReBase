{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "label", "from_email", "from_name", "api_key", "account_key"],
  "properties": {
    "id": { "type": "string", "pattern": "^email_brevo_config:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "label": { "type": "string", "minLength": 2 },
    "visibility": { "type": "boolean", "default": false },
    "from_email": { "type": "string", "format": "email" },
    "from_name": { "type": "string", "minLength": 2 },
    "reply_to": { "type": "string", "format": "email" },
    "api_key": { "type": "string", "minLength": 1 },
    "compliance_note": { "type": "string" },
    "account_key": { "type": "string", "minLength": 4 }
  }
}
