{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "config", "amount_paise"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
    "config": { "type": "string", "pattern": "^razorpay_config:.+$" },
    "amount_paise": { "type": "integer", "minimum": 100, "maximum": 1000000000 },
    "currency": { "type": "string", "enum": ["INR"] }
  }
}
