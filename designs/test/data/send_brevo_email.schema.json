{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "config", "to", "subject"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
    "config": { "type": "string", "pattern": "^rebase_email_delivery_config:.+$" },
    "to": {
      "type": "array",
      "items": { "type": "string", "format": "email" },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "subject": { "type": "string", "minLength": 1 },
    "html": { "type": "string" },
    "text": { "type": "string" }
  }
}
