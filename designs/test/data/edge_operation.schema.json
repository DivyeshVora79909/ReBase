{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "action", "setting", "idempotency_key"],
  "properties": {
    "id": { "type": "string", "pattern": "^edge_operation:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "action": {
      "enum": [
        "email.send",
        "storage.upload",
        "storage.download",
        "storage.delete"
      ]
    },
    "context": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9-]+$" },
    "request": { "type": "object", "default": {} },
    "setting": { "type": "string", "pattern": "^setting:[a-z0-9-]+$" },
    "template": { "type": "string", "pattern": "^setting:[a-z0-9-]+$" },
    "files": {
      "type": "array",
      "items": { "type": "string", "pattern": "^edge_file:[a-z0-9-]+$" },
      "default": []
    },
    "object_key": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "status": {
      "enum": ["pending", "processing", "completed", "failed"],
      "default": "pending"
    },
    "attempts": { "type": "integer", "default": 0 },
    "claimed_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "provider_result": { "type": "object", "default": {} },
    "error": { "type": "object", "default": {} }
  }
}
