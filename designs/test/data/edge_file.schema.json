{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owned_by",
    "name",
    "content_type",
    "size",
    "etag",
    "object_key"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^edge_file:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "name": { "type": "string" },
    "content_type": {
      "enum": ["application/json", "text/plain", "image/png", "application/pdf"]
    },
    "size": { "type": "integer", "minimum": 0 },
    "etag": { "type": "string" },
    "object_key": { "type": "string" },
    "status": { "enum": ["available", "deleted"], "default": "available" }
  }
}
