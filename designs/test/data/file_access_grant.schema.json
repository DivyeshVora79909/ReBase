{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "storage_config", "object_key"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "storage_config": { "type": "string", "pattern": "^file_storage_config:[a-z0-9-]+$" },
    "object_key": { "type": "string", "minLength": 1 },
    "expires_in": { "type": "integer", "minimum": 1, "maximum": 604800, "x-rebase-optional-probability": 0.8 }
  }
}
