{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "parents"],
  "properties": {
    "name": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{8,31}$"
    },
    "parents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "a_favorite_primitive": {
      "type": "string",
      "pattern": "^test_primitive:.+$"
    },
    "a_friends": {
      "type": "array",
      "items": { "type": "string", "pattern": "^rebase_user:.+$" },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    },
    "a_watched_items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(test_primitive|test_tree):.+$"
      },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
