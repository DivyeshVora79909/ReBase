{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "a_primitive"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
    "a_primitive": {
      "type": "string",
      "pattern": "^test_primitive:.+$"
    },
    "a_polymorphic": {
      "type": "string",
      "pattern": "^(test_primitive|rebase_user):.+$"
    },
    "a_primitive_array": {
      "type": "array",
      "items": { "type": "string", "pattern": "^test_primitive:.+$" },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    },
    "a_poly_array": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(test_primitive|rebase_group):.+$"
      },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
