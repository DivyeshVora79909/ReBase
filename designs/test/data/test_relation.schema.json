{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "a_primitive"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "a_primitive": {
      "type": "string",
      "pattern": "^test_primitive:[a-z0-9-]+$"
    },
    "a_polymorphic": {
      "type": "string",
      "pattern": "^(test_primitive|user):[a-z0-9-]+$",
      "x-rebase-optional-probability": 0.55
    },
    "a_primitive_array": {
      "type": "array",
      "items": { "type": "string", "pattern": "^test_primitive:[a-z0-9-]+$" },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    },
    "a_poly_array": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(test_primitive|groups):[a-z0-9-]+$"
      },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "x-rebase-optional-probability": 0.35
    }
  }
}
