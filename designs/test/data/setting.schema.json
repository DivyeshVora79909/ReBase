{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "slug"],
  "properties": {
    "id": { "type": "string", "pattern": "^setting:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "target_table": { "type": "string" },
    "target_record": {
      "type": "string",
      "pattern": "^(test_primitive|setting|test_relation|test_multiref|test_tree):[a-z0-9-]+$"
    },
    "secondary_record": {
      "type": "string",
      "pattern": "^(test_primitive|test_relation|test_multiref|test_tree):[a-z0-9-]+$"
    },
    "dependency": {
      "type": "string",
      "pattern": "^(user|groups|test_primitive|setting|test_relation|test_multiref|test_tree):[a-z0-9-]+$"
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$" },
    "is_active": { "type": "boolean", "default": true },
    "payload": { "type": "object", "default": {} },
    "secrets": { "type": "object", "default": {} }
  }
}
