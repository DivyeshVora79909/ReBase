{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "access_key_id", "secret_access_key", "endpoint", "region"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "provider": { "type": "string", "minLength": 2, "x-rebase-optional-probability": 0.9 },
    "visibility": { "type": "boolean", "x-rebase-optional-probability": 0.45 },
    "access_key_id": { "type": "string", "minLength": 1 },
    "secret_access_key": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "format": "uri" },
    "region": { "type": "string", "minLength": 1 },
    "default_expiry_seconds": { "type": "integer", "minimum": 1, "maximum": 604800, "x-rebase-optional-probability": 0.8 }
  }
}
