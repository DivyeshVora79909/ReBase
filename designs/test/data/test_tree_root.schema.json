{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "a_name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^test_tree:[a-z0-9-]{6,32}$"
    },
    "owned_by": {
      "type": "string",
      "pattern": "^(user|groups):[a-z0-9-]{4,32}$"
    },
    "a_name": {
      "type": "string",
      "minLength": 2
    }
  }
}
