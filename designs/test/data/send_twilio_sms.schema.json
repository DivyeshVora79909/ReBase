{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "config", "to", "body"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
    "config": { "type": "string", "pattern": "^rebase_sms_delivery_config:.+$" },
    "to": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$" },
    "body": { "type": "string", "minLength": 1 }
  }
}
