{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "a_name"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "a_name": { "type": "string", "minLength": 2 },
    "a_parent": { "type": "string", "pattern": "^test_tree:[a-z0-9-]+$", "x-rebase-optional-probability": 0.7 },
    "a_related_nodes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^test_tree:[a-z0-9-]+$" },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
