{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "a_name"],
  "properties": {
    "owned_by": { "type": "string", "pattern": "^(rebase_user|rebase_group|rebase_tenant):.+$" },
    "a_name": { "type": "string", "minLength": 2 },
    "a_parent": { "type": "string", "pattern": "^test_tree:.+$" },
    "a_related_nodes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^test_tree:.+$" },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
