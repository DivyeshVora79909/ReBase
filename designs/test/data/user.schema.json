{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "email", "name", "parents"],
  "properties": {
    "id": { "type": "string", "pattern": "^user:[a-z0-9-]+$" },
    "email": {
      "type": "string",
      "format": "email",
      "faker": "internet.email"
    },
    "name": {
      "type": "string",
      "faker": "person.fullName"
    },
    "parents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
      "default": []
    },
    "a_favorite_primitive": {
      "type": "string",
      "pattern": "^test_primitive:[a-z0-9-]+$"
    },
    "a_friends": {
      "type": "array",
      "items": { "type": "string", "pattern": "^user:[a-z0-9-]+$" },
      "default": []
    },
    "a_watched_items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(test_primitive|test_tree):[a-z0-9-]+$"
      },
      "default": []
    }
  }
}
