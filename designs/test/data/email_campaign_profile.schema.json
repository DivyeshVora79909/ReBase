{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owned_by", "profile_key", "name", "config", "subject", "html", "recipients"],
  "properties": {
    "id": { "type": "string", "pattern": "^email_campaign_profile:[a-z0-9-]+$" },
    "owned_by": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "profile_key": { "type": "string", "minLength": 4 },
    "name": { "type": "string", "minLength": 2 },
    "visibility": { "type": "boolean", "default": false },
    "config": { "type": "string", "pattern": "^email_brevo_config:[a-z0-9-]+$" },
    "fallback_config": { "type": "string", "pattern": "^email_brevo_config:[a-z0-9-]+$" },
    "parent_profile": { "type": "string", "pattern": "^email_campaign_profile:[a-z0-9-]+$" },
    "related_profiles": { "type": "array", "items": { "type": "string", "pattern": "^email_campaign_profile:[a-z0-9-]+$" }, "default": [] },
    "reviewer": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "html": { "type": "string", "minLength": 1 },
    "text": { "type": "string" },
    "recipients": { "type": "array", "items": { "type": "string", "format": "email" }, "minItems": 1, "maxItems": 100, "uniqueItems": true }
  }
}
