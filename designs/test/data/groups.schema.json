{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "parents", "role"],
  "properties": {
    "id": { "type": "string", "pattern": "^groups:[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "parents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(user|groups):[a-z0-9-]+$" },
      "default": []
    },
    "role": {
      "type": "array",
      "default": [],
      "items": {
        "enum": [
          "node_create",
          "node_select",
          "node_update",
          "node_delete",
          "test_primitive_select",
          "test_primitive_create",
          "test_primitive_update",
          "test_primitive_delete",
          "test_relation_select",
          "test_relation_create",
          "test_relation_update",
          "test_relation_delete",
          "test_multiref_select",
          "test_multiref_create",
          "test_multiref_update",
          "test_multiref_delete",
          "test_tree_select",
          "test_tree_create",
          "test_tree_update",
          "test_tree_delete",
          "email_brevo_config_select",
          "email_brevo_config_create",
          "email_brevo_config_update",
          "email_brevo_config_delete",
          "file_storage_config_select",
          "file_storage_config_create",
          "file_storage_config_update",
          "file_storage_config_delete",
          "file_access_grant_select",
          "file_access_grant_create",
          "file_access_grant_update",
          "file_access_grant_delete",
          "send_brevo_email_select",
          "send_brevo_email_create",
          "send_brevo_email_update",
          "send_brevo_email_delete"
        ]
      }
    },
    "a_associated_primitive": {
      "type": "string",
      "pattern": "^test_primitive:[a-z0-9-]+$"
    },
    "a_partner_groups": {
      "type": "array",
      "items": { "type": "string", "pattern": "^groups:[a-z0-9-]+$" },
      "default": []
    }
  }
}
