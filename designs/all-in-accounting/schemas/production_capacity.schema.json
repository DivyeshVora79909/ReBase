{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "production_capacity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "production": {
      "type": "string",
      "pattern": "^(?:production):.+$"
    },
    "description": {
      "type": "string"
    },
    "operating_unit": {
      "type": "string",
      "pattern": "^(?:operating_unit):.+$"
    },
    "resource": {
      "type": "string",
      "pattern": "^(?:service):.+$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    }
  },
  "required": [
    "production",
    "operating_unit",
    "resource",
    "quantity"
  ]
}
