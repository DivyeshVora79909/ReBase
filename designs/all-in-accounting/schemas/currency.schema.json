{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "currency.schema.json",
  "title": "currency",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "precision": {
      "type": "integer"
    }
  },
  "required": [
    "owned_by",
    "code",
    "name"
  ]
}
