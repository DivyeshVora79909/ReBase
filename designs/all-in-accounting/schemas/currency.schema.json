{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "currency",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "precision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18
    }
  },
  "required": [
    "code",
    "name"
  ]
}
