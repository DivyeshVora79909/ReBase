{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "exchange_pair",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "given_resource": {
      "type": "string",
      "pattern": "^(?:currency|item|service):.+$"
    },
    "received_resource": {
      "type": "string",
      "pattern": "^(?:currency|item|service):.+$"
    },
    "initial_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "given_resource",
    "received_resource",
    "initial_rate",
    "effective_at"
  ]
}
