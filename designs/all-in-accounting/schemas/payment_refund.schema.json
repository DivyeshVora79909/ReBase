{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "payment_refund.schema.json",
  "title": "payment_refund",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:invoice_settlement):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "entered_invoice_amount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_account": {
      "type": "string",
      "pattern": "^(?:misc_currency_account):.+$"
    },
    "fee_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_lower_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_upper_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_exchange_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_lower_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_upper_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_exchange_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_account": {
      "type": "string",
      "pattern": "^(?:indirect_tax_account):.+$"
    },
    "fee_tax_creditable": {
      "type": "boolean"
    },
    "include_analytics": {
      "type": "boolean"
    }
  },
  "required": [
    "owned_by",
    "source",
    "effective_at",
    "amount"
  ]
}
