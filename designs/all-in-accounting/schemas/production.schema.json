{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "production",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "name": {
      "type": "string"
    },
    "subsidiary": {
      "type": "string",
      "pattern": "^(?:subsidiary):.+$"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "subsidiary",
    "starts_at",
    "ends_at"
  ]
}
