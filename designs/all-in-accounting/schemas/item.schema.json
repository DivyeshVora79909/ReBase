{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "item",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "name": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "pattern": "^(?:measure_unit):.+$"
    },
    "available_from": {
      "type": "string",
      "format": "date-time"
    },
    "available_until": {
      "type": "string",
      "format": "date-time"
    },
    "minimum_duration": {
      "type": "string"
    },
    "maximum_duration": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "unit"
  ]
}
