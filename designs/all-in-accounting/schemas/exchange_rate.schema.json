{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "exchange_rate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "pair": {
      "type": "string",
      "pattern": "^(?:exchange_pair):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "pair",
    "effective_at",
    "rate"
  ]
}
