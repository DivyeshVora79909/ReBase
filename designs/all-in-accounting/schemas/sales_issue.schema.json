{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sales_issue.schema.json",
  "title": "sales_issue",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "invoice": {
      "type": "string",
      "pattern": "^(?:sales_invoice):.+$"
    },
    "stock_account": {
      "type": "string",
      "pattern": "^(?:stock_account|misc_stock_account):.+$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "exchange_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owned_by",
    "invoice",
    "stock_account",
    "quantity",
    "price",
    "exchange_rate",
    "effective_at"
  ]
}
