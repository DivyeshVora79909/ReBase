{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sales_issue",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "invoice": {
      "type": "string",
      "pattern": "^(?:sales_invoice):.+$"
    },
    "stock_account": {
      "type": "string",
      "pattern": "^(?:stock_account|misc_stock_account):.+$"
    },
    "counterparty_stock": {
      "type": "string",
      "pattern": "^(?:organization_resource_account):.+$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    },
    "price": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "invoice",
    "stock_account",
    "counterparty_stock",
    "quantity",
    "price",
    "effective_at"
  ]
}
