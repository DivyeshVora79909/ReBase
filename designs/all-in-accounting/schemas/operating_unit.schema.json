{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "operating_unit.schema.json",
  "title": "operating_unit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "name": {
      "type": "string"
    },
    "capacity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    }
  },
  "required": [
    "owned_by",
    "name"
  ]
}
