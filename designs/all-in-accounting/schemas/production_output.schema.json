{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "production_output.schema.json",
  "title": "production_output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "production": {
      "type": "string",
      "pattern": "^(?:production):.+$"
    },
    "stock_account": {
      "type": "string",
      "pattern": "^(?:stock_account|misc_stock_account):.+$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    }
  },
  "required": [
    "owned_by",
    "production",
    "stock_account",
    "quantity"
  ]
}
