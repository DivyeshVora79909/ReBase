{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "production_output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "production": {
      "type": "string",
      "pattern": "^(?:production):.+$"
    },
    "description": {
      "type": "string"
    },
    "stock_account": {
      "type": "string",
      "pattern": "^(?:stock_account|misc_stock_account):.+$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    }
  },
  "required": [
    "production",
    "stock_account",
    "quantity"
  ]
}
