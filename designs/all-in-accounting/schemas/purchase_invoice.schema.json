{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "purchase_invoice",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "account": {
      "type": "string",
      "pattern": "^(?:organization_currency_account):.+$"
    },
    "number": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "account",
    "invoice_date"
  ]
}
