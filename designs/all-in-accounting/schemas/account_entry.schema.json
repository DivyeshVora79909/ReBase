{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "account_entry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "account": {
      "type": "string",
      "pattern": "^(?:treasury|misc_currency_account|direct_tax_account|indirect_tax_account|organization_currency_account):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "real": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "receivable": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "payable": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    }
  },
  "required": [
    "account",
    "effective_at"
  ],
  "anyOf": [
    {
      "required": [
        "real"
      ],
      "properties": {
        "real": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
          "not": {
            "pattern": "^-?0+(?:\\.0+)?$"
          }
        }
      }
    },
    {
      "required": [
        "receivable"
      ],
      "properties": {
        "receivable": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "not": {
            "pattern": "^-?0+(?:\\.0+)?$"
          }
        }
      }
    },
    {
      "required": [
        "payable"
      ],
      "properties": {
        "payable": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "not": {
            "pattern": "^-?0+(?:\\.0+)?$"
          }
        }
      }
    }
  ]
}
