{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "issue_adjustment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:sales_issue|purchase_issue):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "adjustment_note": {
      "type": "string",
      "pattern": "^(?:sales_adjustment_note|purchase_adjustment_note):.+$"
    },
    "quantity_delta": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "price_delta": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    }
  },
  "required": [
    "source",
    "effective_at",
    "adjustment_note"
  ],
  "anyOf": [
    {
      "required": [
        "quantity_delta"
      ],
      "properties": {
        "quantity_delta": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
          "not": {
            "pattern": "^-?0+(?:\\.0+)?$"
          }
        }
      }
    },
    {
      "required": [
        "price_delta"
      ],
      "properties": {
        "price_delta": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
          "not": {
            "pattern": "^-?0+(?:\\.0+)?$"
          }
        }
      }
    }
  ]
}
