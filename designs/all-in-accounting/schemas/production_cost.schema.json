{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "production_cost.schema.json",
  "title": "production_cost",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "production": {
      "type": "string",
      "pattern": "^(?:production):.+$"
    },
    "treasury": {
      "type": "string",
      "pattern": "^(?:treasury|misc_currency_account):.+$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_account": {
      "type": "string",
      "pattern": "^(?:misc_currency_account):.+$"
    },
    "fee_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_lower_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_upper_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_exchange_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_lower_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_upper_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_exchange_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_account": {
      "type": "string",
      "pattern": "^(?:indirect_tax_account):.+$"
    },
    "fee_tax_creditable": {
      "type": "boolean"
    },
    "include_analytics": {
      "type": "boolean"
    }
  },
  "required": [
    "owned_by",
    "production",
    "treasury",
    "amount"
  ]
}
