{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "claim_settlement",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:account_claim):.+$"
    },
    "paid_account": {
      "type": "string",
      "pattern": "^(?:treasury|misc_currency_account|stock_account|misc_stock_account):.+$"
    },
    "exchange_pair": {
      "type": "string",
      "pattern": "^(?:exchange_pair):.+$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "fee_account": {
      "type": "string",
      "pattern": "^(?:misc_currency_account):.+$"
    },
    "fee_tax_account": {
      "type": "string",
      "pattern": "^(?:indirect_tax_account):.+$"
    },
    "fee_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_lower_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_lower_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_upper_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_upper_bound": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "fee_tax_creditable": {
      "type": "boolean"
    },
    "fee_exchange_pair": {
      "type": "string",
      "pattern": "^(?:exchange_pair):.+$"
    },
    "fee_tax_exchange_pair": {
      "type": "string",
      "pattern": "^(?:exchange_pair):.+$"
    }
  },
  "required": [
    "source",
    "paid_account",
    "amount",
    "effective_at"
  ]
}
