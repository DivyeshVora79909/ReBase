{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Record strings accept simple table:custom-key and SDK spellings table:⟨custom-key⟩ or table:u\"<uuid>\".",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "from_party", "to_account", "amount", "effective_at"],
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^rebase_(user|group|tenant):(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$"
    },
    "from_party": {
      "type": "string",
      "pattern": "^(?:rebase_user|organization|tax_account|misc_account):(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$"
    },
    "to_account": {
      "type": "string",
      "pattern": "^treasury_account:(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$"
    },
    "amount": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "effective_at": { "type": "string", "format": "date-time" }
  }
}
