{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "payment_adjustment.schema.json",
  "title": "payment_adjustment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:invoice_settlement):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "amount_delta": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "entered_invoice_delta": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    }
  },
  "required": [
    "owned_by",
    "source",
    "effective_at",
    "amount_delta"
  ]
}
