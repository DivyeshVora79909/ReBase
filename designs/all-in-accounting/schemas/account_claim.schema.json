{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "account_claim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "account": {
      "type": "string",
      "pattern": "^(?:organization_currency_account|organization_resource_account|direct_tax_account|indirect_tax_account):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "claim_kind": {
      "type": "string",
      "enum": [
        "receivable",
        "payable"
      ]
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "not": {
        "pattern": "^-?0+(?:\\.0+)?$"
      }
    }
  },
  "required": [
    "account",
    "effective_at",
    "claim_kind",
    "amount"
  ]
}
