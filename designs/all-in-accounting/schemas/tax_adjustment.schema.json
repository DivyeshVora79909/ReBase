{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tax_adjustment.schema.json",
  "title": "tax_adjustment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^(?:rebase_user|rebase_group|rebase_tenant):.+$"
    },
    "source_tax": {
      "type": "string",
      "pattern": "^(?:issue_tax|issue_net_tax):.+$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "entered_account_delta": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "amount_delta": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "adjustment_note": {
      "type": "string",
      "pattern": "^(?:sales_adjustment_note|purchase_adjustment_note):.+$"
    }
  },
  "required": [
    "owned_by",
    "source_tax",
    "effective_at",
    "amount_delta"
  ]
}
