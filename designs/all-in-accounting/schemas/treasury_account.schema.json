{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Record strings accept simple table:custom-key and SDK spellings table:⟨custom-key⟩ or table:u\"<uuid>\".",
  "type": "object",
  "additionalProperties": false,
  "required": ["owned_by", "economic_entity", "treasury", "currency"],
  "properties": {
    "owned_by": {
      "type": "string",
      "pattern": "^rebase_(user|group):(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$"
    },
    "economic_entity": {
      "type": "string",
      "pattern": "^(?:rebase_user|organization):(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$"
    },
    "treasury": { "type": "string", "pattern": "^treasury:(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$" },
    "currency": { "type": "string", "pattern": "^currency:(?:[A-Za-z0-9_-]+|⟨[A-Za-z0-9_-]+⟩|u\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\")$" },
    "minimum_balance": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
