{
  "name": "rebase-surreal-compiler",
  "version": "0.2.0",
  "private": true,
  "description": "Declarative SurrealDB compiler, table-keyed effect runtime, and schema-driven development workbench.",
  "scripts": {
    "build": "node dev-tools/compiler/cli.js",
    "build:all-in-one": "node dev-tools/compiler/cli.js --project designs/all-in-one --output build/all-in-one",
    "build:all-in-accounting": "node dev-tools/compiler/cli.js --project designs/all-in-accounting --output build/all-in-accounting",
    "check": "node dev-tools/compiler/cli.js --check",
    "check:all-in-one": "node dev-tools/compiler/cli.js --check --project designs/all-in-one --output build/all-in-one",
    "check:all-in-accounting": "node dev-tools/compiler/cli.js --check --project designs/all-in-accounting --output build/all-in-accounting",
    "server": "node gateway/server.js",
    "workbench": "node dev-tools/workbench.js",
    "populate": "node dev-tools/populate.js",
    "migrate:one-shot": "node dev-tools/lifecycle-migration.js",
    "probe": "node dev-tools/probe.js all",
    "probe:architecture": "node dev-tools/architecture-probe.js",
    "probe:compiler": "node dev-tools/compiler-probe.js",
    "probe:environment": "node dev-tools/environment-probe.js",
    "probe:authentication": "node dev-tools/authentication-probe.js",
    "probe:credentials": "node dev-tools/credential-probe.js",
    "probe:runtime": "node dev-tools/runtime-probe.js",
    "probe:scheduling": "node dev-tools/scheduling-probe.js",
    "probe:webhook-inbox": "node dev-tools/webhook-inbox-probe.js",
    "probe:razorpay-refunds": "node dev-tools/razorpay-refund-probe.js",
    "probe:adapters": "node dev-tools/adapter-probe.js",
    "probe:queues": "node dev-tools/queue-probe.js",
    "probe:admission": "node dev-tools/admission-capacity-probe.js",
    "probe:dead-letters": "node dev-tools/dead-letter-retention-probe.js",
    "probe:reference-permissions": "node dev-tools/reference-permission-performance.js",
    "probe:accounts": "node dev-tools/accounts-probe.js",
    "probe:accounts-write-only": "node dev-tools/accounts-probe.js --write-only",
    "probe:accounting-core": "node dev-tools/accounting/core-probe.js",
    "probe:accounting-h4a": "node dev-tools/accounting/h4a-probe.js",
    "probe:accounting-h4b": "node dev-tools/accounting/h4b-probe.js",
    "probe:accounting-h4b2": "node dev-tools/accounting/h4b2-probe.js",
    "probe:accounting-h4b3": "node dev-tools/accounting/h4b3-probe.js",
    "probe:accounting-h4b4a": "node dev-tools/accounting/h4b4a-probe.js",
    "probe:accounting-h4b4b": "node dev-tools/accounting/h4b4b-probe.js",
    "probe:accounting-h4b5a": "node dev-tools/accounting/h4b5a-probe.js",
    "probe:accounting-h4b5b": "node dev-tools/accounting/h4b5b-probe.js",
    "probe:stock-timestamp-guard": "node dev-tools/accounting/stock-timestamp-probe.js",
    "probe:accounting-h5b": "node dev-tools/accounting/stock-return-probe.js",
    "probe:accounting-h5c": "node dev-tools/accounting/cash-refund-probe.js",
    "probe:treasury-timestamp-guard": "node dev-tools/accounting/treasury-timestamp-probe.js",
    "probe:write-amplification": "node dev-tools/write-amplification-probe.js",
    "probe:synthetic-write-amplification": "node dev-tools/synthetic-write-amplification-probe.js",
    "probe:temporal-tree": "node dev-tools/temporal-tree/probe.js",
    "probe:ordinal-tree": "node dev-tools/temporal-tree/ordinal-probe.js",
    "probe:typed-tree": "node dev-tools/temporal-tree/typed-probe.js",
    "probe:boundary-tree": "node dev-tools/temporal-tree/boundary-probe.js",
    "probe:derived-order": "node dev-tools/temporal-tree/derived-order-probe.js",
    "probe:required-outputs": "node dev-tools/temporal-tree/required-outputs-probe.js",
    "probe:causal-outputs": "node dev-tools/temporal-tree/causal-outputs-probe.js",
    "verify": "npm run check && npm run check:all-in-one && surreal validate build/test/schema.surql && surreal validate build/all-in-one/schema.surql && surreal validate build/test/migrate-one-shot-backfill.surql && surreal validate build/test/migrate-one-shot-finalize.surql && surreal validate build/all-in-one/migrate-one-shot-backfill.surql && surreal validate build/all-in-one/migrate-one-shot-finalize.surql && npm run probe:environment && npm run probe:authentication && npm run probe:credentials && npm run probe:compiler && npm run probe:architecture && npm run probe:queues && npm run probe:admission && npm run probe:dead-letters && npm run probe:runtime && npm run probe:scheduling && npm run probe:webhook-inbox && npm run probe:adapters && npm run probe:temporal-tree && npm run probe:typed-tree && npm run probe:boundary-tree && npm run probe:derived-order && npm run probe:required-outputs && npm run probe:causal-outputs && npm run probe:accounts && npm run probe:suite && npm run probe",
    "probe:suite": "node dev-tools/suite-probe.js",
    "probe:accounting-h6a": "node dev-tools/accounting/h6a-probe.js",
    "probe:accounting-h6b": "node dev-tools/accounting/h6b-probe.js",
    "probe:accounting-h7-gross-input": "node dev-tools/accounting/h7-gross-input-probe.js",
    "probe:accounting-h7-assembly": "node dev-tools/accounting/h7-assembly-probe.js",
    "probe:accounting-h8-feasibility": "node dev-tools/accounting/h8-production-feasibility-probe.js",
    "probe:accounting-h8": "node dev-tools/accounting/h8-timed-production-probe.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@faker-js/faker": "^9.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "6.2.0",
    "ioredis": "6.0.0",
    "json-schema-faker": "^0.5.9",
    "seedrandom": "^3.0.5",
    "surrealdb": "^2.0.8"
  }
}
