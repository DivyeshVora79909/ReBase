{
  "name": "rebase-surreal-compiler",
  "version": "0.2.0",
  "private": true,
  "description": "Declarative SurrealDB compiler, table-keyed effect runtime, and schema-driven development workbench.",
  "scripts": {
    "build": "node dev-tools/compiler/cli.js",
    "build:all-in-one": "node dev-tools/compiler/cli.js --project designs/all-in-one --output build/all-in-one",
    "build:all-in-accounting": "node dev-tools/compiler/cli.js --project designs/all-in-accounting --output build/all-in-accounting",
    "check": "node dev-tools/compiler/cli.js --check",
    "check:all-in-one": "node dev-tools/compiler/cli.js --check --project designs/all-in-one --output build/all-in-one",
    "check:all-in-accounting": "node dev-tools/compiler/cli.js --check --project designs/all-in-accounting --output build/all-in-accounting",
    "server": "node gateway/server.js",
    "workbench": "node dev-tools/workbench.js",
    "populate": "node dev-tools/populate.js",
    "migrate:one-shot": "node dev-tools/lifecycle-migration.js",
    "probe": "node dev-tools/checks/probe.js all",
    "probe:architecture": "node dev-tools/checks/architecture-probe.js",
    "probe:compiler": "node dev-tools/checks/compiler-probe.js",
    "probe:environment": "node dev-tools/checks/environment-probe.js",
    "probe:authentication": "node dev-tools/checks/authentication-probe.js",
    "probe:credentials": "node dev-tools/checks/credential-probe.js",
    "probe:runtime": "node dev-tools/checks/runtime-probe.js",
    "probe:scheduling": "node dev-tools/checks/scheduling-probe.js",
    "probe:webhook-inbox": "node dev-tools/checks/webhook-inbox-probe.js",
    "probe:razorpay-refunds": "node dev-tools/checks/razorpay-refund-probe.js",
    "probe:adapters": "node dev-tools/checks/adapter-probe.js",
    "probe:queues": "node dev-tools/checks/queue-probe.js",
    "probe:admission": "node dev-tools/checks/admission-capacity-probe.js",
    "probe:dead-letters": "node dev-tools/checks/dead-letter-retention-probe.js",
    "probe:reference-permissions": "node dev-tools/experiments/reference-permission-performance.js",
    "probe:accounts": "node dev-tools/checks/accounts-probe.js",
    "probe:accounts-write-only": "node dev-tools/checks/accounts-probe.js --write-only",
    "probe:accounting-core": "node dev-tools/accounting/probe.js",
    "probe:write-amplification": "node dev-tools/experiments/write-amplification-probe.js",
    "probe:synthetic-write-amplification": "node dev-tools/experiments/synthetic-write-amplification-probe.js",
    "probe:temporal-tree": "node dev-tools/temporal-tree/probe.js",
    "probe:ordinal-tree": "node dev-tools/temporal-tree/ordinal-probe.js",
    "probe:typed-tree": "node dev-tools/temporal-tree/typed-probe.js",
    "probe:typed-tree-seeded": "node dev-tools/temporal-tree/typed-probe.js",
    "probe:boundary-tree": "node dev-tools/temporal-tree/boundary-probe.js",
    "probe:derived-order": "node dev-tools/temporal-tree/derived-order-probe.js",
    "probe:required-outputs": "node dev-tools/temporal-tree/required-outputs-probe.js",
    "probe:causal-outputs": "node dev-tools/temporal-tree/causal-outputs-probe.js",
    "verify": "npm run check && npm run check:all-in-one && npm run check:all-in-accounting && npm run check:index-analytics && surreal validate build/index-analytics/schema.surql && surreal validate build/all-in-accounting/schema.surql && surreal validate build/test/schema.surql && surreal validate build/all-in-one/schema.surql && surreal validate build/test/migrate-one-shot-backfill.surql && surreal validate build/test/migrate-one-shot-finalize.surql && surreal validate build/all-in-one/migrate-one-shot-backfill.surql && surreal validate build/all-in-one/migrate-one-shot-finalize.surql && npm run probe:environment && npm run probe:authentication && npm run probe:tenant-auth && npm run probe:tenant-records && npm run probe:reader-index && npm run probe:passkeys && npm run probe:credentials && npm run probe:compiler && npm run probe:architecture && npm run probe:queues && npm run probe:admission && npm run probe:dead-letters && npm run probe:runtime && npm run probe:live && npm run probe:scheduling && npm run probe:webhook-inbox && npm run probe:adapters && npm run probe:temporal-tree && npm run probe:typed-tree && npm run probe:ordered-tree && npm run probe:boundary-tree && npm run probe:derived-order && npm run probe:observed-reads && npm run probe:required-outputs && npm run probe:causal-outputs && npm run probe:accounts && npm run probe:suite && npm run probe && npm run test:dev-tools",
    "probe:suite": "node dev-tools/checks/suite-probe.js",
    "test:dev-tools": "node --test dev-tools/tests/*.test.js dev-tools/temporal-tree/read-oracle.test.js",
    "probe:tenant-auth": "node dev-tools/checks/tenant-auth-probe.js",
    "probe:tenant-records": "node dev-tools/checks/tenant-record-probe.js",
    "probe:passkeys": "node dev-tools/checks/passkey-probe.js",
    "probe:ordered-tree": "node dev-tools/temporal-tree/ordered-probe.js",
    "probe:live": "node dev-tools/checks/live-probe.js",
    "verify:accounting": "npm run check:all-in-accounting && surreal validate build/all-in-accounting/schema.surql && node dev-tools/accounting/probe.js --all",
    "build:index-analytics": "node dev-tools/compiler/cli.js --project designs/index-analytics --output build/index-analytics",
    "check:index-analytics": "node dev-tools/compiler/cli.js --check --project designs/index-analytics --output build/index-analytics",
    "probe:reader-index": "node dev-tools/checks/reader-index-probe.js",
    "probe:accounting-extensions": "node dev-tools/accounting/extension-probe.js",
    "probe:accounting-integrity-fx": "node dev-tools/accounting/integrity-fx-probe.js",
    "probe:accounting-capture-regression": "node dev-tools/accounting/capture-repro-probe.js",
    "probe:observed-reads": "node dev-tools/temporal-tree/observed-probe.js",
    "probe:observed-reads-seeded": "node dev-tools/temporal-tree/observed-history-probe.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@faker-js/faker": "^9.9.0",
    "@simplewebauthn/server": "^13.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "6.2.0",
    "ioredis": "6.0.0",
    "json-schema-faker": "^0.5.9",
    "seedrandom": "^3.0.5",
    "surrealdb": "^2.0.8",
    "ws": "^8.22.0"
  }
}
