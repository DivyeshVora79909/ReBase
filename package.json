{
  "name": "rebase-surreal-compiler",
  "version": "0.2.0",
  "private": true,
  "description": "Declarative SurrealDB compiler, table-keyed effect runtime, and schema-driven development workbench.",
  "scripts": {
    "build": "node dev-tools/compiler/cli.js",
    "check": "node dev-tools/compiler/cli.js --check",
    "server": "node gateway/server.js",
    "workbench": "node dev-tools/workbench.js",
    "populate": "node dev-tools/populate.js",
    "probe": "node dev-tools/probe.js all",
    "probe:architecture": "node dev-tools/architecture-probe.js",
    "probe:compiler": "node dev-tools/compiler-probe.js",
    "probe:environment": "node dev-tools/environment-probe.js",
    "probe:runtime": "node dev-tools/runtime-probe.js",
    "probe:adapters": "node dev-tools/adapter-probe.js",
    "probe:queues": "node dev-tools/queue-probe.js",
    "verify": "npm run check && surreal validate build/test/schema.surql && npm run probe:environment && npm run probe:compiler && npm run probe:architecture && npm run probe:queues && npm run probe:runtime && npm run probe:adapters && npm run probe"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/client-sqs": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@faker-js/faker": "^9.9.0",
    "@hono/node-server": "^2.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "6.2.0",
    "cron-parser": "5.4.0",
    "hono": "^4.13.1",
    "ioredis": "6.0.0",
    "json-schema-faker": "^0.5.9",
    "seedrandom": "^3.0.5",
    "surrealdb": "^2.0.8"
  }
}
