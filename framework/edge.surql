USE NS main DB main;

-- Operational execution state. These tables are not business audit history.
DEFINE TABLE edge_job SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD capability ON edge_job TYPE string;
DEFINE FIELD actor ON edge_job TYPE option<record<user | groups>>;
DEFINE FIELD records ON edge_job TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD args ON edge_job TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD result ON edge_job TYPE option<object> FLEXIBLE DEFAULT NONE;
DEFINE FIELD error ON edge_job TYPE option<object> FLEXIBLE DEFAULT NONE;
DEFINE FIELD status ON edge_job TYPE string ASSERT $value IN ['queued', 'running', 'waiting', 'succeeded', 'failed', 'cancelled'];
DEFINE FIELD attempts ON edge_job TYPE int DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD max_attempts ON edge_job TYPE int DEFAULT 3 ASSERT $value >= 0;
DEFINE FIELD lease_owner ON edge_job TYPE option<string> DEFAULT NONE;
DEFINE FIELD lease_expires_at ON edge_job TYPE option<datetime> DEFAULT NONE;
DEFINE FIELD next_run_at ON edge_job TYPE datetime DEFAULT time::now();
DEFINE FIELD provider_job_id ON edge_job TYPE option<string> DEFAULT NONE;
DEFINE FIELD idempotency_key ON edge_job TYPE string;
DEFINE FIELD created_at ON edge_job TYPE datetime VALUE $before OR time::now() READONLY;
DEFINE FIELD updated_at ON edge_job TYPE datetime VALUE time::now();
DEFINE FIELD finished_at ON edge_job TYPE option<datetime> DEFAULT NONE;
DEFINE FIELD revision ON edge_job TYPE uuid VALUE rand::uuid::v7();
DEFINE INDEX idx_edge_job_status ON edge_job COLUMNS status, next_run_at;
DEFINE INDEX idx_edge_job_actor ON edge_job COLUMNS actor;
DEFINE INDEX idx_edge_job_idempotency ON edge_job COLUMNS idempotency_key UNIQUE;

DEFINE TABLE edge_outbox SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD job_id ON edge_outbox TYPE record<edge_job> REFERENCE ON DELETE CASCADE;
DEFINE FIELD topic ON edge_outbox TYPE string;
DEFINE FIELD envelope ON edge_outbox TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD status ON edge_outbox TYPE string ASSERT $value IN ['pending', 'publishing', 'published', 'failed'];
DEFINE FIELD attempts ON edge_outbox TYPE int DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD max_attempts ON edge_outbox TYPE int DEFAULT 10 ASSERT $value > 0;
DEFINE FIELD available_at ON edge_outbox TYPE datetime DEFAULT time::now();
DEFINE FIELD lease_owner ON edge_outbox TYPE option<string> DEFAULT NONE;
DEFINE FIELD lease_expires_at ON edge_outbox TYPE option<datetime> DEFAULT NONE;
DEFINE FIELD published_at ON edge_outbox TYPE option<datetime> DEFAULT NONE;
DEFINE FIELD last_error ON edge_outbox TYPE option<string> DEFAULT NONE;
DEFINE FIELD created_at ON edge_outbox TYPE datetime VALUE $before OR time::now() READONLY;
DEFINE FIELD updated_at ON edge_outbox TYPE datetime VALUE time::now();
DEFINE FIELD revision ON edge_outbox TYPE uuid VALUE rand::uuid::v7();
DEFINE INDEX idx_edge_outbox_pending ON edge_outbox COLUMNS status, available_at;
DEFINE INDEX idx_edge_outbox_job ON edge_outbox COLUMNS job_id;

DEFINE TABLE edge_log SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD at ON edge_log TYPE datetime DEFAULT time::now();
DEFINE FIELD request_id ON edge_log TYPE option<string> DEFAULT NONE;
DEFINE FIELD job_id ON edge_log TYPE option<record<edge_job>> REFERENCE ON DELETE IGNORE DEFAULT NONE;
DEFINE FIELD capability ON edge_log TYPE string;
DEFINE FIELD phase ON edge_log TYPE string;
DEFINE FIELD outcome ON edge_log TYPE string;
DEFINE FIELD actor ON edge_log TYPE option<record<user | groups>> DEFAULT NONE;
DEFINE FIELD provider ON edge_log TYPE option<string> DEFAULT NONE;
DEFINE FIELD duration_ms ON edge_log TYPE option<int> DEFAULT NONE;
DEFINE FIELD error_code ON edge_log TYPE option<string> DEFAULT NONE;
DEFINE FIELD data ON edge_log TYPE object FLEXIBLE DEFAULT {};
DEFINE INDEX idx_edge_log_request ON edge_log COLUMNS request_id;
DEFINE INDEX idx_edge_log_job ON edge_log COLUMNS job_id;
DEFINE INDEX idx_edge_log_at ON edge_log COLUMNS at;

DEFINE TABLE edge_webhook_receipt SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD dedupe_key ON edge_webhook_receipt TYPE string;
DEFINE FIELD capability ON edge_webhook_receipt TYPE string;
DEFINE FIELD provider ON edge_webhook_receipt TYPE option<string> DEFAULT NONE;
DEFINE FIELD provider_event_id ON edge_webhook_receipt TYPE string;
DEFINE FIELD status ON edge_webhook_receipt TYPE string ASSERT $value IN ['processing', 'succeeded', 'failed'];
DEFINE FIELD attempts ON edge_webhook_receipt TYPE int DEFAULT 1 ASSERT $value > 0;
DEFINE FIELD lease_owner ON edge_webhook_receipt TYPE option<string> DEFAULT NONE;
DEFINE FIELD lease_expires_at ON edge_webhook_receipt TYPE option<datetime> DEFAULT NONE;
DEFINE FIELD result ON edge_webhook_receipt TYPE option<object> FLEXIBLE DEFAULT NONE;
DEFINE FIELD error ON edge_webhook_receipt TYPE option<object> FLEXIBLE DEFAULT NONE;
DEFINE FIELD created_at ON edge_webhook_receipt TYPE datetime VALUE $before OR time::now() READONLY;
DEFINE FIELD updated_at ON edge_webhook_receipt TYPE datetime VALUE time::now();
DEFINE FIELD revision ON edge_webhook_receipt TYPE uuid VALUE rand::uuid::v7();
DEFINE INDEX idx_edge_webhook_dedupe ON edge_webhook_receipt COLUMNS dedupe_key UNIQUE;
DEFINE INDEX idx_edge_webhook_status ON edge_webhook_receipt COLUMNS status, lease_expires_at;
