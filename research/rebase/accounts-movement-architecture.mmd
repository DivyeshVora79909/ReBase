%% Accounts-only architecture. The Accounts slice is implemented under
%% designs/all-in-one/accounts; synchronous prefix replay is live, while
%% checkpoint/block-summary optimization and future domains remain extensions.
flowchart TB
  Client["MetaSol / client facts"] --> Runtime["Stateless runtime\ncompiled descriptors"]
  Runtime --> DB["SurrealDB\nreferences, VALUE, ASSERT, events, views"]

  subgraph Kernel["Canonical Accounts primitives"]
    Org["organization / party"]
    Currency["currency"]
    Fx["fx_rate snapshot"]
    Treasury["treasury_account\n(one currency, guarded)"]
    Misc["misc_account\n(client-defined offset)"]
    Unit["operating_unit"]
    Item["item"]
    Service["service"]
    Rule["tax_rule"]
  end

  Currency --> Treasury
  Currency --> Misc
  Currency --> Fx
  Org --> Treasury
  Unit --> Item
  Unit --> Service
  Rule --> TaxIn
  Rule --> TaxOut

  subgraph Movement["Specialized movement families"]
    Money["money_movement\nfrom/to typed endpoints"]
    Exchange["money_exchange\ntwo explicit currency legs"]
    Stock["inventory_movement\nfrom/to typed nodes"]
    Delivery["service_delivery"]
    Capacity["service_capacity"]
  end

  Treasury -. "record union" .-> Money
  Misc -. "record union" .-> Money
  Org -. "record union" .-> Money
  Treasury -. "source/destination leg" .-> Exchange
  Misc -. "source/destination leg" .-> Exchange
  Org -. "source/destination leg" .-> Exchange
  Currency --> Exchange
  Fx --> Exchange
  Unit -. "stock node" .-> Stock
  Org -. "external node" .-> Stock
  Item --> Stock
  Service --> Delivery
  Unit --> Delivery
  Capacity --> Delivery

  subgraph Positions["Mutable write anchors"]
    MoneyPos["money_position\nendpoint + currency"]
    StockPos["inventory_position\nunit + item (+ lot)"]
    ServicePos["service_position\nunit + service (+ period)"]
    Revision["revision / audit snapshot"]
  end

  Money --> MoneyPos
  Exchange --> MoneyPos
  Stock --> StockPos
  Delivery --> ServicePos
  Capacity --> ServicePos
  MoneyPos --> Revision
  StockPos --> Revision
  ServicePos --> Revision

  subgraph Claims["Claims and settlement wrappers"]
    Invoice["invoice\nclaim wrapper"]
    Line["invoice_line\nitem | service"]
    Application["payment_application\nmany-to-many settlement"]
    Refund["money_refund\noriginal payment cap"]
    Return["inventory_return\noriginal delivery cap"]
    Note["adjustment_note\noptional lock"]
    MoneyAdj["money_adjustment_line"]
    StockAdj["inventory_adjustment_line"]
    TaxAdj["tax_adjustment_line"]
  end

  Org --> Invoice
  Invoice --> Line
  Line --> Application
  Money --> Application
  Money --> Refund
  Stock --> Return
  Note --> MoneyAdj
  Note --> StockAdj
  Note --> TaxAdj
  MoneyAdj -. "target" .-> Money
  StockAdj -. "target" .-> Stock

  subgraph Tax["Tax assessment components"]
    TaxIn["tax_input\nline-bound component"]
    TaxOut["tax_output\nline-bound component"]
    TaxView["tax liability projections"]
  end

  Line --> TaxIn
  Line --> TaxOut
  TaxIn --> TaxView
  TaxOut --> TaxView
  TaxAdj --> TaxIn
  TaxAdj --> TaxOut
  TaxView -. "optional settlement context" .-> Money

  subgraph Reactive["Database-owned reactive pipeline"]
    A["a_* authoritative facts"]
    D["d_* direct shadows / derivations"]
    E["e_* synchronous guards"]
    V["v_* sparse materialized views\nread-only"]
    Ping["reverse invalidation\nold + new targets"]
    Repair["bounded replay / rebuild"]
    A --> D --> V
    A --> E
    V --> Ping --> E
    Revision --> Repair --> V
  end

  Money --> A
  Exchange --> A
  Stock --> A
  Delivery --> A
  Capacity --> A
  Invoice --> A
  Line --> A
  Application --> A
  Refund --> A
  Return --> A
  TaxIn --> A
  TaxOut --> A
  Note --> A
  E --> DB

  subgraph Time["Temporal contract"]
    Effective["effective_at\nimmutable business order"]
    Recorded["recorded_at\nsystem audit order"]
    Fold["array::fold\nminimum-prefix replay"]
    Checkpoint["future checkpoints /\nsegment summaries"]
  end

  Money --> Effective
  Stock --> Effective
  Delivery --> Effective
  Effective --> Fold --> Checkpoint
  Recorded --> Revision

  subgraph Rules["Integrity boundaries"]
    Current["current position\nOCC + non-negative guard"]
    ClaimsRule["claim/application caps"]
    TaxRule["tax base + direction"]
    RefRule["typed REFERENCE\nexplicit exists assertion"]
  end

  MoneyPos --> Current
  StockPos --> Current
  ServicePos --> Current
  Application --> ClaimsRule
  Refund --> ClaimsRule
  Return --> ClaimsRule
  TaxView --> TaxRule
  Money --> RefRule
  Stock --> RefRule
  Claims --> RefRule

  classDef source fill:#e8f5e9,stroke:#2e7d32,color:#102a13;
  classDef derived fill:#e3f2fd,stroke:#1565c0,color:#0d2742;
  classDef guard fill:#fff3e0,stroke:#ef6c00,color:#4a2400;
  classDef context fill:#f3e5f5,stroke:#7b1fa2,color:#32103f;
  class A,Money,Exchange,Stock,Delivery,Capacity,Invoice,Line,Application,Refund,Return,TaxIn,TaxOut,Note source;
  class D,V,MoneyPos,StockPos,ServicePos,TaxView,Revision,Recorded derived;
  class E,Ping,Repair,Current,ClaimsRule,TaxRule,RefRule,Fold guard;
  class Client,Runtime,DB,Checkpoint context;
